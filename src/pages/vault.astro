  <style is:global>
    /* One predictable exit, outside scrolling/animated cards and torn-paper clipping. */
    .room-close, #deskX.room-close { position: fixed; z-index: 12; top: max(14px, env(safe-area-inset-top)); right: max(16px, env(safe-area-inset-right)); width: 44px; height: 44px; min-width: 44px; min-height: 44px; margin: 0; padding: 0; display: grid; place-items: center; border: 1px solid #6a4a18; border-radius: 50%; background: linear-gradient(#e2c27a, #b48a3c); color: #2a1a06; font: 600 24px/1 Georgia, serif; box-shadow: 0 2px 6px #0008; cursor: pointer; touch-action: manipulation; }
    .room-close:hover { background: #f0d796; }
    #slowBar { padding-right: 66px !important; }
    body:has(.room-panel:not([hidden])) #slowBar { display: none !important; }
    #slowBar > .room-close { position: absolute; top: 8px; right: 8px; }
    .room-close:focus-visible { outline: 3px solid #fff3c4; outline-offset: 3px; }
    /* The room exit gets its own lane. Content scrolls only below that lane. */
    .room-panel[id] { top: max(66px, calc(env(safe-area-inset-top) + 58px)) !important; bottom: 0 !important; height: auto !important; padding-top: 12px !important; overflow-y: auto; }
    .room-panel::before { content: ''; position: fixed; z-index: 11; inset: 0 0 auto; height: max(66px, calc(env(safe-area-inset-top) + 58px)); background: #100c08; pointer-events: none; }
    #desk.room-panel .desk-card { height: calc(100vh - 90px); height: calc(100dvh - 90px); }
    .word-mic-status { min-height: 1.4em; font-size: 14px !important; line-height: 1.4; margin: 10px 0 !important; }
    /* Filters on scrolling roots establish a containing block for fixed descendants;
       keep the room dimmed while the exit stays anchored to the viewport. */
    #desk, #notebook, #draft, #reward, #pageview, #wordbox, #carvebox, #roundEnd, #lockbox, #tilecard, #farewell, #pvGame, #certPanel { backdrop-filter: none !important; -webkit-backdrop-filter: none !important; filter: none !important; transform: none !important; }
    .vb-pages { display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; margin: 10px 0; }
    .vb-pages button { min-height: 44px; }
    .vb-pages button:disabled { opacity: .5; cursor: default; }
    .vb-page-status, .vb-own-label { text-align: center; color: #5a4a2a; font-size: 14px; }
    #vbOwn[hidden], #vbRetry[hidden] { display: none; }
  </style>
  <script is:inline>
    (function () {
      var routes = { desk: 'deskX', notebook: 'nbClose', draft: 'draftClose', reward: 'rewardClose', pageview: 'pageClose', wordbox: 'wbCancel', carvebox: 'cbCancel', roundEnd: 'reBack', lockbox: 'lockBack', tilecard: 'tcClose', farewell: 'fwStay', certPanel: 'certClose' };
      var labels = { desk: 'Rise from the desk and return to the vault', notebook: 'Close the notebook', draft: 'Close the page or Visitors’ Book', reward: 'Close the gift', pageview: 'Close the story page', wordbox: 'Close word entry', carvebox: 'Close the register', roundEnd: 'Close the round result', lockbox: 'Close the listening lock', tilecard: 'Close the key-tile', farewell: 'Stay in the vault', certPanel: 'Close the certificate', pvGame: 'Close this panel' };
      var focusBefore = new WeakMap(), wasOpen = new WeakMap();
      function restoreFocus(panel) {
        var prior = focusBefore.get(panel);
        if (prior && prior !== document.body && prior.isConnected && !panel.contains(prior) && prior.getClientRects().length && prior.focus) {
          prior.focus({ preventScroll: true });
          if (document.activeElement === prior) return;
        }
        var painted = document.body.classList.contains('painted');
        var room = document.getElementById(painted ? 'pvStage' : 'stage');
        if (room && room.getClientRects().length) {
          room.setAttribute('tabindex', '-1'); room.focus({ preventScroll: true });
        }
      }
      function dismiss(id) {
        var panel = document.getElementById(id); if (!panel || panel.hidden) return;
        if (id === 'globeView') { if (window.__globeClose) window.__globeClose(); return; }
        if (id === 'pvGame') {
          var old = panel.querySelector('#lockBack, #regClose, #letClose, #tileClose'); if (old) old.click(); else panel.hidden = true;
        } else {
          var target = document.getElementById(id === 'draft' && panel.classList.contains('scrap') ? 'scrapClose' : routes[id]);
          if (target) target.click();
        }
        if (panel.hidden) restoreFocus(panel);
      }
      window.__roomDismiss = dismiss;
      function sync() {
        var slow = document.getElementById('slowBar');
        if (slow && !slow.querySelector(':scope > .room-close')) {
          var sx = document.createElement('button'); sx.type = 'button'; sx.className = 'room-close'; sx.textContent = '×'; sx.setAttribute('aria-label', 'Dismiss the performance suggestion');
          sx.addEventListener('click', function () { document.getElementById('slowDismiss').click(); }); slow.prepend(sx);
        }
        Object.keys(labels).forEach(function (id) {
          var panel = document.getElementById(id); if (!panel) return;
          panel.classList.add('room-panel');
          var isOpen = !panel.hidden, opened = isOpen && !wasOpen.get(panel);
          if (opened) focusBefore.set(panel, document.activeElement);
          if (!isOpen && wasOpen.get(panel) && panel.contains(document.activeElement)) {
            restoreFocus(panel);
          }
          wasOpen.set(panel, isOpen);
          if (!panel.hasAttribute('role') && !panel.querySelector('[role=dialog]')) { panel.setAttribute('role', 'dialog'); panel.setAttribute('aria-modal', 'true'); panel.setAttribute('aria-label', labels[id].replace(/^Close /, '')); }
          if (!panel.querySelector(':scope > .room-close')) {
            var x = document.createElement('button'); x.type = 'button'; x.className = 'room-close'; x.textContent = '×'; x.setAttribute('aria-label', labels[id]); x.title = labels[id];
            x.addEventListener('click', function () { dismiss(id); }); panel.prepend(x);
          }
          if (opened && !panel.contains(document.activeElement)) panel.querySelector(':scope > .room-close').focus({ preventScroll: true });
        });
      }
      var deskX = document.getElementById('deskX'); if (deskX) { deskX.classList.add('room-close'); deskX.textContent = '×'; document.getElementById('desk').prepend(deskX); }
      sync(); new MutationObserver(sync).observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['hidden'] });
      document.addEventListener('keydown', function (e) {
        if ((e.key !== 'Escape' && e.key !== 'Tab') || e.defaultPrevented) return;
        var ids = ['globeView', 'certPanel', 'farewell', 'pvGame', 'wordbox', 'carvebox', 'desk', 'draft', 'notebook', 'lockbox', 'tilecard', 'roundEnd', 'pageview', 'reward'];
        var id = ids.find(function (id) { var p = document.getElementById(id); return p && !p.hidden; });
        if (!id) return;
        if (e.key === 'Tab') {
          var panel = document.getElementById(id), tabs = Array.from(panel.querySelectorAll('button, a[href], input, select, textarea, iframe, [tabindex]')).filter(function (el) { return !el.disabled && el.tabIndex >= 0 && el.getClientRects().length; });
          if (!tabs.length) return;
          var first = tabs[0], last = tabs[tabs.length - 1], active = document.activeElement;
          if (!panel.contains(active) || (e.shiftKey ? active === first : active === last)) { e.preventDefault(); (e.shiftKey ? last : first).focus(); }
          return;
        }
        e.preventDefault(); e.stopImmediatePropagation(); dismiss(id);
      }, true);
    })();
  </script>

  <script is:inline>
    /* THE BACK BUTTON never throws you out of the vault by surprise. Installed here, before any
       scene loads, for BOTH modes. Two entries of our own: [base][top]. Opening any overlay pushes
       one more; Back pops it and closes the overlay; closing by button pops it quietly. With
       nothing open, Back lands on base → one warning; Back again within 12 s really leaves. */
    (function () {
      var IDS = ['reward', 'pageview', 'wordbox', 'carvebox', 'desk', 'notebook', 'draft', 'pvGame', 'certPanel', 'lockbox', 'tilecard', 'roundEnd', 'farewell', 'globeView'];
      var el = function (id) { return document.getElementById(id); };
      var anyOpen = function () { return IDS.some(function (id) { var e = el(id); return e && !e.hidden; }); };
      var pushed = false, quiet = 0, warned = false, warnT = null;
      function say(text) {
        var painted = document.body.classList.contains('painted');
        var t = el(painted ? 'pvCapText' : 'capText'); if (!t) return;
        t.textContent = text;
        var c = el(painted ? 'pvCap' : 'capText'); if (c) { c.classList.add('show'); setTimeout(function () { c.classList.remove('show'); }, 6500); }
      }
      function closeAll() {
        IDS.forEach(function (id) {
          var e = el(id); if (!e || e.hidden) return;
          if (window.__roomDismiss) { window.__roomDismiss(id); return; }
          if (id === 'globeView') { if (window.__globeClose) window.__globeClose(); return; }   // the Keeper's globe close-up
          if (id === 'desk' && window.__vaultRise) window.__vaultRise();
          else if (id === 'wordbox' && el('wbCancel')) el('wbCancel').click();   // through the cancel path, so the "gave up at this door" line still fires
          else e.hidden = true;
        });
        if (window.__painted && window.__painted.round && window.__painted.round.on && window.__painted.endRound) window.__painted.endRound(false);
      }
      try {
        history.replaceState({ vault: 1, base: 1 }, '');
        history.pushState({ vault: 1, top: 1 }, '');
        new MutationObserver(function () {
          var open = anyOpen();
          if (open && !pushed) { pushed = true; history.pushState({ vault: 1, ov: 1 }, ''); }
          else if (!open && pushed) { pushed = false; quiet++; history.back(); setTimeout(function () { quiet = Math.max(0, quiet - 1); }, 400); }
        }).observe(document.documentElement, { attributes: true, attributeFilter: ['hidden'], subtree: true });
        window.addEventListener('popstate', function () {
          if (quiet > 0) { quiet--; return; }
          if (anyOpen()) { pushed = false; closeAll(); return; }
          pushed = false;
          if (history.state && history.state.base) {
            if (!warned) {
              warned = true; clearTimeout(warnT); warnT = setTimeout(function () { warned = false; }, 12000);
              history.pushState({ vault: 1, top: 1 }, '');
              say('Back once more to leave the vault — or use “the landing” at the top. Your stamps and pages are kept either way.');
            } else history.back();
          }
        });
      } catch (e) { /* no history API — nothing lost */ }
    })();
  </script>
  <script is:inline>
    // Switching view must retain the earned act and door hand-off.
    (function () {
      var u = new URL(location.href); u.searchParams.set('mode', 'painted');
      ['modeChip', 'gate2d'].forEach(function (id) {
        var a = document.getElementById(id); if (a) a.href = u.pathname + u.search + u.hash;
      });
      u.searchParams.set('mode', '3d');
      document.querySelectorAll('#pv3d, .pv-gate-alt').forEach(function (a) {
        a.href = u.pathname + u.search + u.hash;
      });
    })();
  </script>
