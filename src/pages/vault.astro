---
import FlatVault from '../components/FlatVault.astro';
// VAULT I — THE WRITER'S STUDY. First-person walkable 3D room (Three.js r155).
// Look reference: assets/vault_concepts/vault1_writers_study_v4.jpg (Dan-approved).
// Movement: drag to look, tap floor to walk, W/▲/scroll glides forward (no free WASD).
// Interactables: glowing puzzle stack (50-puzzle reward PDF), secret bookcase → passage
// to the sealed Vault II door. Audio/SFX ported from the landing (Web Audio, no files).
// Debug/screenshot params: ?cam=x,z,yaw,pitch (skips gate, no audio) ?open=1 ?panel=1

// Cookieless analytics (no cookies, no personal data) — this page builds its
// own HTML instead of using Layout.astro, so it needs its own <Analytics />.
import Analytics from '@vercel/analytics/astro';
---
<!doctype html>
<html lang="en">
<head>
    <meta name="p:domain_verify" content="e74f3a68cdf6a1e0175624d5717e2746" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>The Keeper's Vaults · PuzzleSecret</title>
  <meta name="description" content="Step inside the Keeper's vaults. Three doors, three words, three rewards." />
  <meta name="robots" content="noindex" />
  <!-- Self-hosted fonts (the FAQ promises zero external font tracking - keep it true). -->
  <link rel="stylesheet" href="/fonts/fonts.css" />
</head>
<body>
  <div id="stage"></div>

  <!-- HUD -->
  <div id="hud">
    <div id="brand">PUZZLESECRET · <span id="roomName">VAULT I — THE WRITER'S STUDY</span></div>
    <a id="backlink" href="/">◄ the landing</a>
    <a id="modeChip" href="/vault?mode=painted" title="The same vaults, painted">see it painted</a>
    <button id="muteBtn" aria-label="Mute">🔊</button>
    <div id="hint">Drag to look around · Tap the floor to walk · Click what glows</div>
    <button id="fwdBtn" aria-label="Walk forward">▲</button>
    <div id="caption"><span id="capText"></span></div>
    <div id="label"></div>
    <div id="studyCount" hidden></div>
  </div>

  <!-- THE KEEPER'S DESK — sit, and play today's page (the arcade in a parchment frame) -->
  <div id="desk" hidden>
    <div class="desk-card">
      <div class="desk-head">
        <div class="reward-kicker">THE KEEPER’S DESK</div>
        <p class="desk-line" id="deskLine"></p>
        <p class="desk-stamps" id="deskStamps"></p>
      </div>
      <div class="desk-frame"><iframe id="deskFrame" title="Today's puzzle at the Keeper's desk" loading="lazy"></iframe></div>
      <div class="word-actions"><button id="deskRise" class="ghost-btn">Rise from the desk</button></div>
    </div>
  </div>

  <!-- THE KEEPER'S NOTEBOOK — six pages, the last one a sketch of what comes next -->
  <div id="notebook" hidden>
    <div class="page-card nb-card">
      <div class="page-no" id="nbNo">THE KEEPER’S NOTEBOOK</div>
      <div class="nb-body" id="nbBody"></div>
      <div class="nb-nav">
        <button id="nbPrev" class="ghost-btn">◄ Back</button>
        <button id="nbNext" class="ghost-btn">Turn the page ►</button>
      </div>
      <button id="nbClose" class="ghost-btn">Set it down →</button>
    </div>
  </div>

  <!-- A REJECT, UNFOLDED — a page in the book's own dress, with two answers -->
  <div id="draft" hidden>
    <div class="draft-wrap">
      <div class="sheet" id="draftSheet">
        <div class="sheet-win">
          <div class="sheet-head" id="draftHead">DRAFT · TWO ANSWERS</div>
          <div class="grid9" id="draftGrid"></div>
        </div>
        <div class="sheet-stamp">REJECTED</div>
      </div>
      <div class="draft-side">
        <p class="draft-note" id="draftNote"></p>
        <div class="nb-nav">
          <button id="draftA" class="ghost-btn">One answer</button>
          <button id="draftB" class="ghost-btn">…and the other</button>
        </div>
        <button id="draftClose" class="ghost-btn">Crumple it again →</button>
      </div>
    </div>
  </div>

  <!-- Entry gate (enables audio) -->
  <div id="gate">
    <div class="gate-inner">
      <div class="gate-kicker">THE WORD WAS TRUE</div>
      <h1>THE&nbsp;VAULTS</h1>
      <button id="enterBtn">⟡ &nbsp;Step inside</button>
      <a id="gate2d" href="/vault?mode=painted">or explore the painted vault</a>
    </div>
  </div>

  <!-- Reward panel (dynamic — serves all three vaults) -->
  <div id="reward" hidden>
    <div class="reward-card">
      <div class="reward-kicker" id="rwKicker">THE KEEPER'S FIRST GIFT</div>
      <h2 id="rwTitle">FIFTY PUZZLES, YOURS</h2>
      <p id="rwText">No name, no price. Fifty easy puzzles from the Keeper's own desk —
         the first door is open.</p>
      <a class="gold-btn" id="rwBtn" href="#" download>Download the 50 puzzles (PDF)</a>
      <!-- Shown only on the deepest vaults (III, IV). The puzzles above download either
           way - this is never a gate, and it never asks for a rating or a star count. -->
      <div id="rwAsk" hidden>
        <p class="ask-text">Dan here — the human who actually built this. The puzzles above
          are yours either way. But if the hunt was worth your time, an honest review helps a
          self-published book find the next solver.</p>
        <a class="ask-btn" id="rwAskBtn"
           href="https://www.amazon.com/review/create-review?asin=B0HB9K8PXC"
           target="_blank" rel="noopener noreferrer">Leave an honest review →</a>
      </div>
      <button id="rewardClose" class="ghost-btn">Keep exploring →</button>
    </div>
  </div>

  <!-- The Keeper's Story — a lifted manuscript page -->
  <div id="pageview" hidden>
    <div class="page-card">
      <div class="page-no" id="pgNo">PAGE ONE</div>
      <p class="page-body" id="pgBody"></p>
      <div class="page-found" id="pgFound">Pages found: 1 of 9</div>
      <button id="pageClose" class="ghost-btn">Set it back down →</button>
    </div>
  </div>

  <!-- Word entry (sealed doors — server-checked, words never in this page) -->
  <div id="wordbox" hidden>
    <div class="reward-card word-card">
      <div class="reward-kicker" id="wbKicker">THE SECOND DOOR</div>
      <p class="word-line" id="wbLine">Say the word.</p>
      <div id="tiles"></div>
      <input id="wbInput" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="12" aria-label="The secret word" />
      <div class="word-actions">
        <button id="speakBtn" class="ghost-btn">🎙 &nbsp;Speak the word</button>
        <button id="wbSubmit" class="gold-btn">Open the door</button>
        <button id="wbCancel" class="ghost-btn">Step back</button>
      </div>
      <div id="wbMsg"></div>
    </div>
  </div>

  <!-- The Keeper's register (initials only, 2-3 letters, by design) -->
  <div id="carvebox" hidden>
    <div class="reward-card word-card">
      <div class="reward-kicker">THE KEEPER'S REGISTER</div>
      <p class="word-line">Leave no name. Names are for the world above. Down here, a mark is enough.</p>
      <input id="cbInput" type="text" autocomplete="off" autocapitalize="characters"
             spellcheck="false" maxlength="3" placeholder="your initials"
             aria-label="Your initials, two or three letters" />
      <label class="cb-age"><input type="checkbox" id="cbAge" /> <span>I am 13 or older.</span></label>
      <div class="word-actions">
        <button id="cbSubmit" class="gold-btn">Carve it</button>
        <button id="cbCancel" class="ghost-btn">Step back</button>
      </div>
      <div id="cbMsg"></div>
    </div>
  </div>

  <FlatVault />

  <canvas id="confetti"></canvas>
  <div id="fade"></div>

  <style is:global>
    :root {
      --gold: #f6b23c;
      --gold-dim: #b07c25;
      --parchment: #e8d5ae;
      --ink: #0b0704;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; overflow: hidden; background: var(--ink); }
    body { font-family: 'Cormorant Garamond', serif; color: var(--parchment); }
    #stage, #stage canvas { position: fixed; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }
    #stage::after { /* candlelit vignette — pulls every room toward the concept-art mood */
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(ellipse at 50% 42%, transparent 52%, rgba(8,3,0,0.5) 100%);
    }

    /* ---- HUD ---- */
    #hud { position: fixed; inset: 0; pointer-events: none; z-index: 5; }
    #brand {
      position: absolute; top: 14px; left: 50%; transform: translateX(-50%);
      font-family: Cinzel, serif; font-size: 11px; letter-spacing: 0.32em;
      color: rgba(232,213,174,0.6); white-space: nowrap;
    }
    #brand span { color: var(--gold); }
    #backlink {
      position: absolute; top: 12px; left: 14px; pointer-events: auto;
      font-family: Cinzel, serif; font-size: 10px; letter-spacing: 0.2em;
      color: rgba(232,213,174,0.55); text-decoration: none;
    }
    #backlink:hover { color: var(--gold); }
    #modeChip {
      position: absolute; top: 12px; right: 54px; pointer-events: auto;
      font-family: Cinzel, serif; font-size: 10px; letter-spacing: .14em; text-transform: uppercase;
      color: rgba(232,213,174,.7); text-decoration: none; border: 1px solid rgba(246,178,60,.3);
      border-radius: 999px; padding: 8px 12px; background: rgba(14,10,6,.6);
    }
    #modeChip:hover { color: var(--gold); border-color: rgba(246,178,60,.6); }
    #muteBtn {
      position: absolute; top: 8px; right: 12px; pointer-events: auto;
      background: none; border: 1px solid rgba(246,178,60,0.25); border-radius: 50%;
      width: 34px; height: 34px; color: var(--parchment); font-size: 14px; cursor: pointer;
    }
    #hint {
      position: absolute; bottom: 12px; right: 16px; font-style: italic;
      font-size: 14px; color: rgba(232,213,174,0.45); text-align: right;
    }
    #fwdBtn {
      position: absolute; bottom: 64px; left: 50%; transform: translateX(-50%);
      pointer-events: auto; width: 52px; height: 52px; border-radius: 50%;
      background: rgba(20,12,4,0.55); border: 1px solid rgba(246,178,60,0.4);
      color: var(--gold); font-size: 18px; cursor: pointer; backdrop-filter: blur(2px);
    }
    #fwdBtn:active { background: rgba(246,178,60,0.25); }
    #caption {
      position: absolute; bottom: 0; left: 0; right: 0; padding: 16px 20px 20px;
      text-align: center; pointer-events: none;
      background: linear-gradient(transparent, rgba(5,3,1,0.85));
    }
    #capText {
      font-size: clamp(17px, 2.4vw, 23px); font-style: italic; font-weight: 600;
      color: var(--parchment); text-shadow: 0 1px 8px #000;
      opacity: 0; transition: opacity 0.8s;
    }
    #capText.show { opacity: 1; }
    #label {
      position: absolute; padding: 4px 10px; font-family: Cinzel, serif;
      font-size: 11px; letter-spacing: 0.14em; color: var(--gold);
      background: rgba(10,6,2,0.78); border: 1px solid rgba(246,178,60,0.35);
      border-radius: 3px; white-space: nowrap; display: none;
      transform: translate(-50%, -160%);
    }

    /* ---- gate / panels ---- */
    #gate {
      position: fixed; inset: 0; z-index: 20; display: flex; align-items: center;
      justify-content: center; background: radial-gradient(ellipse at 50% 60%, #1a0f04 0%, #070402 70%);
      transition: opacity 1.4s; text-align: center;
    }
    /* the gate is the painted study the door revealed (arriving from the door skips it entirely) */
    #gate, #fade.from-door { background: #070402 url(/art/rooms/study.webp) center 55% / cover no-repeat; }
    #gate::before { content: ''; position: absolute; inset: 0; background: rgba(4,2,0,.55); }
    #gate .gate-inner { position: relative; }
    #gate.gone { opacity: 0; pointer-events: none; }
    .gate-kicker { font-family: Cinzel, serif; font-size: 11px; letter-spacing: 0.4em; color: var(--gold-dim); margin-bottom: 18px; }
    #gate h1 { font-family: Cinzel, serif; font-weight: 700; font-size: clamp(44px, 9vw, 84px); letter-spacing: 0.18em; color: var(--gold); text-shadow: 0 0 40px rgba(246,178,60,0.35); }
    .gate-sub { font-family: Cinzel, serif; font-size: clamp(14px, 2.4vw, 20px); letter-spacing: 0.34em; color: var(--parchment); margin-top: 10px; }
    .gate-line { font-style: italic; font-size: 17px; color: rgba(232,213,174,0.65); margin: 26px 0 30px; }
    #enterBtn {
      font-family: Cinzel, serif; font-size: 15px; letter-spacing: 0.22em; cursor: pointer;
      color: var(--ink); background: linear-gradient(180deg, #ffd37a, #d99a2b);
      border: none; border-radius: 4px; padding: 15px 38px;
      box-shadow: 0 0 34px rgba(246,178,60,0.35);
    }
    #enterBtn:hover { filter: brightness(1.08); }
    #gate2d {
      display: block; margin: 18px auto 0; font-size: 14px; font-style: italic;
      color: rgba(232,213,174,0.5); text-decoration: underline; text-underline-offset: 3px;
    }
    #gate2d:hover { color: var(--gold); }
    #slowBar {
      position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 30;
      display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px;
      padding: 12px 16px; border-radius: 8px;
      background: rgba(12,8,4,0.94); border: 1px solid rgba(246,178,60,0.4);
      box-shadow: 0 10px 34px rgba(0,0,0,0.7);
      font-size: 14px; font-style: italic; color: rgba(232,213,174,0.85);
    }
    #slowBar .ghost-btn { margin-bottom: 0; width: auto; padding: 10px 16px; min-height: 44px; display: flex; align-items: center; }
    #slowDismiss {
      background: none; border: none; cursor: pointer; min-height: 44px; padding: 0 8px;
      font-family: Cinzel, serif; font-size: 12px; letter-spacing: 0.12em;
      color: rgba(232,213,174,0.5); text-transform: uppercase;
    }
    #slowDismiss:hover { color: var(--gold); }

    #reward, #pageview {
      position: fixed; inset: 0; z-index: 15; display: flex; align-items: center;
      justify-content: center; background: rgba(4,2,0,0.6); backdrop-filter: blur(3px);
    }
    #reward[hidden], #pageview[hidden] { display: none; }

    /* A lifted manuscript page — parchment, not the gold reward card, so lore
       reads as a different kind of find from a treasure. */
    .page-card {
      max-width: 470px; width: calc(100% - 40px); text-align: center;
      background: linear-gradient(180deg, #efe2c4, #ddcaa4);
      border: 1px solid rgba(90,64,26,0.5); border-radius: 3px;
      padding: 34px 34px 26px;
      box-shadow: 0 0 50px rgba(246,178,60,0.16), 0 20px 55px rgba(0,0,0,0.75);
      animation: pageLift 0.42s cubic-bezier(.2,.8,.25,1) both;
    }
    @keyframes pageLift { from { opacity: 0; transform: translateY(26px) rotateX(22deg) scale(.94); } }
    @media (prefers-reduced-motion: reduce) { .page-card { animation: none; } }
    .page-no {
      font-family: Cinzel, serif; font-size: 10px; letter-spacing: 0.38em;
      color: #7a5520; margin-bottom: 14px;
    }
    .page-body {
      font-size: 18px; font-style: italic; line-height: 1.55; color: #2c2011;
      margin-bottom: 20px;
    }
    .page-found {
      font-family: Cinzel, serif; font-size: 10px; letter-spacing: 0.2em;
      color: #8a6a33; margin-bottom: 16px;
    }
    .page-card .ghost-btn { color: #6b4d1f; border-color: rgba(90,64,26,0.45); }
    .page-card .ghost-btn:hover { color: #2c2011; border-color: rgba(90,64,26,0.8); }
    .reward-card {
      max-width: 430px; width: calc(100% - 40px); text-align: center;
      background: linear-gradient(180deg, #1d1207, #120a04);
      border: 1px solid rgba(246,178,60,0.45); border-radius: 8px;
      padding: 34px 30px 28px; box-shadow: 0 0 60px rgba(246,178,60,0.18), 0 18px 50px rgba(0,0,0,0.7);
    }
    .reward-kicker { font-family: Cinzel, serif; font-size: 10px; letter-spacing: 0.38em; color: var(--gold-dim); margin-bottom: 12px; }
    .reward-card h2 { font-family: Cinzel, serif; font-size: 24px; letter-spacing: 0.12em; color: var(--gold); margin-bottom: 12px; }
    .reward-card p { font-size: 17px; font-style: italic; color: rgba(232,213,174,0.8); margin-bottom: 22px; line-height: 1.45; }
    .gold-btn {
      display: block; font-family: Cinzel, serif; font-size: 13px; letter-spacing: 0.16em;
      color: var(--ink); background: linear-gradient(180deg, #ffd37a, #d99a2b);
      border-radius: 4px; padding: 14px 10px; text-decoration: none; margin-bottom: 12px;
      box-shadow: 0 0 24px rgba(246,178,60,0.3); border: none; cursor: pointer;
    }
    .ghost-btn {
      display: block; width: 100%; font-family: Cinzel, serif; font-size: 12px;
      letter-spacing: 0.16em; color: rgba(232,213,174,0.65); background: none;
      border: 1px solid rgba(232,213,174,0.25); border-radius: 4px; padding: 11px 10px;
      cursor: pointer; text-decoration: none;
      min-height: 44px;   /* thumb-sized on touch screens */
    }
    .ghost-btn:hover { color: var(--gold); border-color: rgba(246,178,60,0.5); }

    /* ---- word entry ---- */
    #wordbox { position: fixed; inset: 0; z-index: 16; display: flex; align-items: center;
      justify-content: center; background: rgba(4,2,0,0.65); backdrop-filter: blur(3px); }
    #wordbox[hidden] { display: none; }
    .word-card { max-width: 480px; }
    .word-line { font-size: 18px; font-style: italic; color: rgba(232,213,174,0.85); margin-bottom: 20px; }
    #tiles { display: flex; justify-content: center; gap: 8px; margin-bottom: 6px; }
    .tile {
      width: 46px; height: 56px; border: 1px solid rgba(246,178,60,0.45); border-radius: 5px;
      background: rgba(20,12,4,0.7); display: flex; align-items: center; justify-content: center;
      font-family: Cinzel, serif; font-size: 26px; font-weight: 700; color: var(--gold);
      text-shadow: 0 0 12px rgba(246,178,60,0.5); transition: border-color .15s, background .15s;
    }
    .tile.filled { border-color: var(--gold); background: rgba(246,178,60,0.12); }
    #wordbox.shake .word-card { animation: wbshake .45s; }
    @keyframes wbshake { 0%,100%{transform:translateX(0)} 20%{transform:translateX(-9px)} 40%{transform:translateX(8px)} 60%{transform:translateX(-6px)} 80%{transform:translateX(4px)} }
    #wbInput { position: absolute; opacity: 0.01; height: 1px; width: 1px; pointer-events: none; }
    .word-actions { display: flex; flex-direction: column; gap: 10px; margin-top: 18px; }
    .cb-age { display: flex; align-items: center; justify-content: center; gap: 8px;
      margin-top: 14px; font-size: 13px; color: var(--gold-hi, #e8cfa0); opacity: .85; cursor: pointer; }
    .cb-age input { width: 15px; height: 15px; accent-color: #b98f52; cursor: pointer; flex: none; }
    .word-actions .gold-btn, .word-actions .ghost-btn { margin-bottom: 0; }
    #wbMsg { min-height: 22px; margin-top: 12px; font-style: italic; font-size: 15px; color: rgba(232,213,174,0.7); }
    #speakBtn.listening { color: var(--gold); border-color: var(--gold); box-shadow: 0 0 18px rgba(246,178,60,0.35); }
    #carvebox {
      position: fixed; inset: 0; z-index: 15; display: flex; align-items: center;
      justify-content: center; background: rgba(4,2,0,0.6); backdrop-filter: blur(3px);
    }
    #carvebox[hidden] { display: none; }
    #cbInput {
      width: 100%; font-family: Cinzel, serif; font-size: 26px; letter-spacing: 0.5em;
      text-align: center; text-transform: uppercase; color: var(--gold);
      background: rgba(0,0,0,0.45); border: 1px solid rgba(246,178,60,0.4);
      border-radius: 4px; padding: 14px 8px 14px 18px; margin-top: 14px; min-height: 52px;
    }
    #cbInput::placeholder { color: rgba(232,213,174,0.3); letter-spacing: 0.05em; text-transform: none; font-size: 16px; font-style: italic; }
    #cbInput:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 16px rgba(246,178,60,0.3); }
    #cbMsg { min-height: 22px; margin-top: 12px; font-style: italic; font-size: 15px; color: rgba(232,213,174,0.7); }
    @media (max-width: 480px) { .tile { width: 38px; height: 48px; font-size: 21px; } }

    /* --- the review ask: deliberately quieter than the gift above it ---------------
       It sits BELOW the download, is separated by a hairline, and never mentions a
       rating. The reward is unconditional; this is a request, not a toll. */
    #rwAsk[hidden] { display: none; }
    #rwAsk {
      margin: 18px 0 14px; padding-top: 16px;
      border-top: 1px solid rgba(232,213,174,0.16);
    }
    #rwAsk .ask-text {
      font-size: 14px; font-style: normal; line-height: 1.5;
      color: rgba(232,213,174,0.62); margin-bottom: 14px;
    }
    #rwAsk .ask-btn {
      display: block; font-family: Cinzel, serif; font-size: 12px; letter-spacing: 0.16em;
      color: rgba(232,213,174,0.8); background: none;
      border: 1px solid rgba(232,213,174,0.3); border-radius: 4px;
      padding: 12px 10px; text-decoration: none; min-height: 44px;
    }
    #rwAsk .ask-btn:hover { color: var(--gold); border-color: rgba(246,178,60,0.55); }

    /* ---- the study's own pieces ---- */
    #studyCount {
      position: absolute; top: 40px; left: 50%; transform: translateX(-50%);
      font-family: Cinzel, serif; font-size: 10px; letter-spacing: .24em; color: rgba(232,213,174,.55);
      white-space: nowrap; transition: opacity .6s;
    }
    #studyCount[hidden] { display: none; }
    #studyCount b { color: var(--gold); font-weight: 600; }
    #desk, #notebook, #draft {
      position: fixed; inset: 0; z-index: 15; display: flex; align-items: center; justify-content: center;
      background: rgba(4,2,0,0.55); backdrop-filter: blur(2px); padding: 12px;
    }
    #desk[hidden], #notebook[hidden], #draft[hidden] { display: none; }
    #desk { padding: 6px; }
    .desk-card {
      width: min(780px, 100%); max-height: calc(100vh - 12px); display: flex; flex-direction: column;
      background: url(/art/parchment_bg.webp) center / cover #e9dcc0; border: 3px solid #3a2a14; border-radius: 4px;
      box-shadow: 0 0 60px rgba(246,178,60,0.18), 0 18px 50px rgba(0,0,0,0.8); overflow: hidden;
    }
    .desk-head { padding: 12px 16px 8px; text-align: center; background: rgba(255,250,236,.62); border-bottom: 1px solid rgba(58,42,20,.35); }
    .desk-head .reward-kicker { color: #7a5520; }
    .desk-line { font-size: 17px; font-style: italic; color: #2c2011; line-height: 1.35; }
    .desk-stamps { margin-top: 4px; font-family: Cinzel, serif; font-size: 10px; letter-spacing: .18em; color: #8a6a33; }
    .desk-frame { flex: 1; min-height: 0; margin: 0 10px; border: 1px solid rgba(58,42,20,0.6); border-radius: 3px; background: #120d07; }
    .desk-frame iframe { display: block; width: 100%; height: calc(100vh - 150px); border: 0; }
    .desk-card .word-actions { padding: 8px 10px 10px; margin-top: 0; }
    .desk-card .ghost-btn { color: #6b4d1f; border-color: rgba(90,64,26,.5); }
    #draftA[aria-pressed="true"], #draftB[aria-pressed="true"] { background: rgba(246,178,60,.35); color: #2c2011; border-color: #b8760c; }
    .nb-card, .draft-card { max-width: 520px; }
    .nb-body { text-align: left; min-height: 210px; font-size: 17px; font-style: italic; line-height: 1.5; color: #2c2011; }
    .nb-body h4 { font-family: Cinzel, serif; font-style: normal; font-size: 13px; letter-spacing: .18em; color: #7a5520; margin-bottom: 10px; text-align: center; }
    .nb-body p { margin-bottom: 10px; }
    .nb-body .sketch { display: block; width: 100%; max-height: 220px; object-fit: cover; object-position: 50% 30%; border: 1px solid rgba(90,64,26,.5);
      filter: grayscale(.85) sepia(.6) contrast(.9) brightness(1.05); margin: 6px 0 10px; }
    .nb-body .grid4 { display: grid; grid-template-columns: repeat(4, 32px); gap: 2px; margin: 8px auto; }
    .nb-nav { display: flex; gap: 10px; margin: 6px 0 10px; }
    .nb-nav .ghost-btn { margin: 0; }
    /* the reject: the book's own page (its printed border, the grid in the window, a red stamp) */
    .draft-wrap { display: flex; gap: 18px; align-items: center; max-width: 820px; width: 100%; max-height: calc(100vh - 24px); }
    .sheet { position: relative; flex: none; width: min(400px, 46vw); aspect-ratio: 2550 / 3300; background: #f3ecdb center / cover no-repeat; border-radius: 3px;
      box-shadow: 0 24px 60px rgba(0,0,0,.8), 0 0 40px rgba(246,178,60,.12); animation: pageLift .42s cubic-bezier(.2,.8,.25,1) both; }
    .sheet-win { position: absolute; left: 12.2%; top: 11.6%; width: 75.5%; height: 68.8%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4%; }
    .sheet-head { font-family: Cinzel, serif; font-size: clamp(8px, 1.1vw, 12px); letter-spacing: .3em; color: #3a2a14; }
    .grid9 { display: grid; grid-template-columns: repeat(9, 1fr); width: 100%; aspect-ratio: 1; border: 2px solid #1a1208; background: rgba(255,252,244,.55); }
    .grid9 i { display: flex; align-items: center; justify-content: center; font-family: Cinzel, serif; font-style: normal; font-weight: 700; font-size: clamp(9px, 1.5vw, 17px); color: #14100a; border: 1px solid rgba(26,18,8,.55); min-width: 0; }
    .grid9 i.b3 { border-right: 2px solid #1a1208; }
    .grid9 i.r3 { border-bottom: 2px solid #1a1208; }
    .grid9 i.pen { color: #1f4e8c; font-weight: 500; }
    .grid9 i.hot { background: rgba(246,178,60,.55); }
    .sheet-stamp { position: absolute; left: 50%; top: 42%; transform: translate(-50%, -50%) rotate(-18deg); font-family: Cinzel, serif; font-weight: 700; font-size: clamp(22px, 4.6vw, 44px); letter-spacing: .18em;
      color: rgba(160,28,40,.75); border: 4px solid rgba(160,28,40,.7); padding: 4px 16px; border-radius: 6px; pointer-events: none; mix-blend-mode: multiply; }
    .draft-side { flex: 1; min-width: 0; background: linear-gradient(180deg, #efe2c4, #ddcaa4); border: 1px solid rgba(90,64,26,.5); border-radius: 3px; padding: 22px 22px 18px; text-align: center; box-shadow: 0 20px 55px rgba(0,0,0,.75); }
    .draft-side .ghost-btn { color: #6b4d1f; border-color: rgba(90,64,26,.45); }
    .draft-note { font-size: 16px; font-style: italic; color: #2c2011; line-height: 1.45; margin-bottom: 12px; }
    @media (max-width: 700px) {
      #draft { align-items: flex-start; overflow-y: auto; }
      .draft-wrap { flex-direction: column; max-height: none; margin: auto 0; }
      .sheet { width: min(360px, 92vw); }
      .draft-side { width: 100%; padding: 16px; }
    }
    @media (prefers-reduced-motion: reduce) { .sheet { animation: none; } }
    @media (prefers-reduced-motion: reduce) { .nb-card { animation: none; } }

    #confetti { position: fixed; inset: 0; z-index: 18; pointer-events: none; }
    #fade { position: fixed; inset: 0; z-index: 8; background: #000; opacity: 1; pointer-events: none; transition: opacity 2.2s; }
    #fade.clear { opacity: 0; }

    @media (max-width: 640px) {
      #hint { display: none; }
      #brand { font-size: 9px; letter-spacing: 0.18em; top: 46px; max-width: 92vw; white-space: normal; text-align: center; line-height: 1.3; }
      #studyCount { top: 74px; font-size: 9px; }
      #modeChip { right: 52px; top: 10px; font-size: 9px; padding: 7px 9px; }
    }
  </style>

  <script is:inline>
    /* THE BACK BUTTON never throws you out of the vault by surprise. Installed here, before any
       scene loads, for BOTH modes. Two entries of our own: [base][top]. Opening any overlay pushes
       one more; Back pops it and closes the overlay; closing by button pops it quietly. With
       nothing open, Back lands on base → one warning; Back again within 12 s really leaves. */
    (function () {
      var IDS = ['reward', 'pageview', 'wordbox', 'carvebox', 'desk', 'notebook', 'draft', 'pvGame', 'certPanel'];
      var el = function (id) { return document.getElementById(id); };
      var anyOpen = function () { return IDS.some(function (id) { var e = el(id); return e && !e.hidden; }); };
      var pushed = false, quiet = 0, warned = false, warnT = null;
      function say(text) {
        var painted = document.body.classList.contains('painted');
        var t = el(painted ? 'pvCapText' : 'capText'); if (!t) return;
        t.textContent = text;
        var c = el(painted ? 'pvCap' : 'capText'); if (c) { c.classList.add('show'); setTimeout(function () { c.classList.remove('show'); }, 6500); }
      }
      function closeAll() {
        IDS.forEach(function (id) { var e = el(id); if (e && !e.hidden) { if (id === 'desk' && window.__vaultRise) window.__vaultRise(); else e.hidden = true; } });
        if (window.__painted && window.__painted.round && window.__painted.round.on && window.__painted.endRound) window.__painted.endRound(false);
      }
      try {
        history.replaceState({ vault: 1, base: 1 }, '');
        history.pushState({ vault: 1, top: 1 }, '');
        new MutationObserver(function () {
          var open = anyOpen();
          if (open && !pushed) { pushed = true; history.pushState({ vault: 1, ov: 1 }, ''); }
          else if (!open && pushed) { pushed = false; quiet++; history.back(); setTimeout(function () { quiet = Math.max(0, quiet - 1); }, 400); }
        }).observe(document.documentElement, { attributes: true, attributeFilter: ['hidden'], subtree: true });
        window.addEventListener('popstate', function () {
          if (quiet > 0) { quiet--; return; }
          if (anyOpen()) { pushed = false; closeAll(); return; }
          pushed = false;
          if (history.state && history.state.base) {
            if (!warned) {
              warned = true; clearTimeout(warnT); warnT = setTimeout(function () { warned = false; }, 12000);
              history.pushState({ vault: 1, top: 1 }, '');
              say('Back once more to leave the vault — or use “the landing” at the top. Your stamps and pages are kept either way.');
            } else history.back();
          }
        });
      } catch (e) { /* no history API — nothing lost */ }
    })();
  </script>
  <script>
    // Mode is decided synchronously by FlatVault's inline script (window.__flatMode). The 3D
    // crawl is a dynamic import so the painted vault never pays for three.js.
    if (!window.__flatMode) import('../scripts/vault3d.js');
  </script>
