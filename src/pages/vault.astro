---
import FlatVault from '../components/FlatVault.astro';
import DailySignup from '../components/DailySignup.astro';
// VAULT I — THE WRITER'S STUDY. First-person walkable 3D room (Three.js r155).
// Look reference: assets/vault_concepts/vault1_writers_study_v4.jpg (Dan-approved).
// Movement: drag to look, tap floor to walk, W/▲/scroll glides forward (no free WASD).
// Interactables: glowing puzzle stack (50-puzzle reward PDF), secret bookcase → passage
// to the sealed Vault II door. Audio/SFX ported from the landing (Web Audio, no files).
// Debug/screenshot params: ?cam=x,z,yaw,pitch (skips gate, no audio) ?open=1 ?panel=1

// Cookieless analytics (no cookies, no personal data) — this page builds its
// own HTML instead of using Layout.astro, so it needs its own <Analytics />.
import Analytics from '@vercel/analytics/astro';
---
<!doctype html>
<html lang="en">
<head>
  <!-- THE VAULT IS LOCKED WITHOUT A WORD (Dan's call 2026-09-28). A browser gets in only if it has
       spoken a true word: the front door stores the server-issued gift address (ps_rewards_v1) before
       it forwards here, and the vault stamps ps_vaults_v1. No word → back to the front door to type it.
       Client-side on purpose: the gifts themselves are gated on the server (/api/reward); this only
       stops a stranger wandering in. Storage that throws (private mode) fails OPEN so a true solver is
       never stuck in a loop. Debug params (?cam / ?open / ?panel) skip it on loopback hosts only. -->
  <script is:inline>
    (function () {
      try {
        var h = location.hostname, q = new URLSearchParams(location.search);
        var dev = h === 'localhost' || h === '127.0.0.1' || h === '[::1]';
        if (dev && (q.has('cam') || q.has('open') || q.has('panel'))) return;
        var has = function (k) { var v = JSON.parse(localStorage.getItem(k) || '{}'); return !!v && typeof v === 'object' && Object.keys(v).length > 0; };
        if (has('ps_rewards_v1') || has('ps_vaults_v1')) return;
        // Keep where they came from: the front door's arrive line reads this instead of our own vault.
        try { if (!sessionStorage.getItem('ps_arrived')) sessionStorage.setItem('ps_ref', document.referrer || ''); } catch (e) {}
        // A no-word arrival on the door hand-off address (/vault?from=door&act=I) can only have come from a link that
        // skipped a door: in practice PinPoint's GCBYBY3 checker (2026-10-14). Send it to PinPoint's own door, never the
        // book's homepage, which Groundspeak ruled commercial. Book visitors always carry a word here.
        if (q.get('from') === 'door') { location.replace('/pinpoint'); return; }
        location.replace('/' + location.search);
      } catch (e) { /* storage blocked — let them in rather than loop */ }
    })();
  </script>
    <meta name="p:domain_verify" content="e74f3a68cdf6a1e0175624d5717e2746" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <title>The Keeper's Vaults · PuzzleSecret</title>
  <meta name="description" content="Step inside the Keeper's vaults. Three doors, three words, three rewards." />
  <meta name="robots" content="noindex" />
  <!-- Self-hosted fonts (the FAQ promises zero external font tracking - keep it true). -->
  <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="stylesheet" href="/fonts/readability.css" />
</head>
<body>
  <div id="stage"></div>

  <!-- HUD -->
  <div id="hud">
    <div id="brand">PUZZLESECRET · <span id="roomName">VAULT I — THE WRITER'S STUDY</span></div>
    <a id="backlink" href="/">◄ the landing</a>
    <a id="modeChip" href="/vault?mode=painted" title="The same vaults, painted">see it painted</a>
    <button id="muteBtn" aria-label="Mute">🔊</button>
    <div id="hint">Drag to look around · Tap the floor to walk · Click what glows</div>
    <button id="fwdBtn" aria-label="Walk forward">▲</button>
    <div id="caption"><span id="capText" role="status" aria-live="polite"></span></div>
    <div id="label"></div>
    <div id="studyCount" hidden></div>
    <script is:inline>
      // THE KEEPER'S GALLERY (Dan, 2026-11-24): a browser holding only the Gift cover's gift ('G') and no
      // book word sees the Gallery, never Vault I. Name it here before the room loads; the 3D view is the
      // Gallery's home for now, so the painted switch is hidden.
      (function () {
        try {
          var r = JSON.parse(localStorage.getItem('ps_rewards_v1') || '{}') || {}, v = JSON.parse(localStorage.getItem('ps_vaults_v1') || '{}') || {};
          var book = ['I', 'II', 'III', 'IV'].some(function (a) { return r[a] || v[a]; });
          if (book || !r.G) return;
          window.__psGallery = true;
          // the Gallery is never an outlet's guest room: drop a stale one so its title, exits and farewell stay the Gallery's
          try { sessionStorage.removeItem('ps_guest_room_v1'); } catch (e) {}
          document.title = "The Keeper's Gallery · PuzzleSecret";
          var rn = document.getElementById('roomName'); if (rn) rn.textContent = "THE KEEPER'S GALLERY";
          var mc = document.getElementById('modeChip'); if (mc) mc.hidden = true;
          var st = document.createElement('style'); st.textContent = '#gate2d{display:none!important}'; document.head.appendChild(st);   // the painted switch on the gate (built later in the page)
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      // A guest room with its own front door (PinPoint's /pinpoint, 2026-10-13): in BOTH modes its way out
      // is that door, and the switch to the other mode is hidden, so a cacher is never one tap from the book's homepage.
      (function () {
        try {
          var g = JSON.parse(sessionStorage.getItem('ps_guest_room_v1') || 'null');
          var home = g && /^\/[a-z0-9\-]{1,40}$/.test(String(g.home || '')) ? g.home : '';
          if (!home) return;
          var bl = document.getElementById('backlink'); if (bl) { bl.href = home; bl.textContent = '◄ back to the door'; }
          var mc = document.getElementById('modeChip'); if (mc) mc.hidden = true;
          if (g.id === 'pinpoint') {
            document.title = "The Keeper's Study · GCBYBY3";
            var br = document.getElementById('brand'); if (br && br.firstChild && br.firstChild.nodeType === 3) br.firstChild.nodeValue = 'PINPOINT PUZZLER · ';
          }
          var fix = function () { var pb = document.querySelector('.pv-back'); if (pb) { pb.href = home; pb.textContent = '◄ back to the door'; } };
          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fix); else fix();
        } catch (e) {}
      })();
    </script>
  </div>

  <!-- THE KEEPER'S DESK — sit, and play today's page (the arcade in a parchment frame) -->
  <div id="desk" hidden role="dialog" aria-modal="true" aria-labelledby="deskTitle">
    <div class="desk-card">
      <div class="desk-head">
        <button id="deskX" class="desk-x" type="button" aria-label="Rise from the desk and return to the vault" title="Rise from the desk">✕</button>
        <div class="reward-kicker" id="deskTitle">THE KEEPER’S DESK</div>
        <p class="desk-line" id="deskLine"></p>
        <p class="desk-stamps" id="deskStamps"></p>
      </div>
      <div class="desk-frame"><iframe id="deskFrame" title="Today's puzzle at the Keeper's desk" loading="lazy"></iframe></div>
      <div class="word-actions"><button id="deskRise" class="ghost-btn">Rise from the desk</button></div>
    </div>
  </div>

  <!-- THE KEEPER'S NOTEBOOK — six pages, the last one a sketch of what comes next -->
  <div id="notebook" hidden>
    <div class="page-card nb-card">
      <div class="page-no" id="nbNo">THE KEEPER’S NOTEBOOK</div>
      <div class="nb-body" id="nbBody"></div>
      <div class="nb-nav">
        <button id="nbPrev" class="ghost-btn">◄ Back</button>
        <button id="nbNext" class="ghost-btn">Turn the page ►</button>
      </div>
      <button id="nbClose" class="ghost-btn">Set it down →</button>
    </div>
  </div>

  <!-- A REJECT, UNFOLDED — a page in the book's own dress, with two answers -->
  <div id="draft" hidden>
    <div class="draft-wrap">
      <div class="sheet" id="draftSheet">
        <div class="sheet-win">
          <div class="sheet-head" id="draftHead">DRAFT · TWO ANSWERS</div>
          <div class="grid9" id="draftGrid"></div>
        </div>
        <div class="sheet-stamp">REJECTED</div>
      </div>
      <div class="draft-side">
        <p class="draft-note" id="draftNote"></p>
        <div class="nb-nav">
          <button id="draftA" class="ghost-btn">One answer</button>
          <button id="draftB" class="ghost-btn">…and the other</button>
        </div>
        <button id="draftClose" class="ghost-btn">Crumple it again →</button>
      </div>
    </div>
    <!-- A GUEST ROOM's torn note (an outlet's own story inside Vault I). Same overlay, so the pointer gate and the
         Back button already know it; shown only when #draft carries the .scrap class, which only a guest room sets. -->
    <div class="scrap-wrap" aria-live="polite">
      <div class="scrap" id="scrapNote">
        <div class="scrap-kick" id="scrapKick" tabindex="-1">A PIECE OF THE NOTE</div>
        <div class="scrap-text" id="scrapText"></div>
        <div class="scrap-board" id="scrapBoard" hidden>
          <div class="scrap-slots" id="scrapSlots"></div>
          <div class="scrap-full" id="scrapFull"></div>
          <button id="scrapCopy" class="ghost-btn" type="button">Copy the position</button>
          <div id="scrapLogPrompt" class="scrap-log-prompt" hidden>
            <button id="scrapLog" class="ghost-btn" type="button" aria-describedby="scrapLogHint">Sign the Visitors’ Book</button>
            <p id="scrapLogHint">Optional. Leave your initials and general location in the same book as the one on the desk.</p>
          </div>
          <p class="scrap-note-p">The pieces stay pinned for this visit. If you lose them, speak the word again and they come back.</p>
        </div>
        <p class="scrap-say" id="scrapSay"></p>
        <!-- The PinPoint VISITORS' BOOK (Dan, 2026-11-14): optional, never part of the find. Initials,
             a country, a state/county where offered and optionally a town of 15,000+, all from lists — nothing typed freely. -->
        <div class="vb" id="vb" hidden>
          <button id="vbBackToPosition" class="ghost-btn" type="button" hidden>Back to coordinates</button>
          <form class="vb-form" id="vbForm" autocomplete="off" hidden>
            <p class="vb-note">Optional, and not part of your find. Initials and your area only, never your name or address. Everyone who visits can read it.</p>
            <label class="vb-l" for="vbIni">Initials</label>
            <input class="vb-in" id="vbIni" maxlength="3" autocapitalize="characters" autocorrect="off" spellcheck="false" autocomplete="off" />
            <label class="vb-l" for="vbCc">Country</label>
            <select class="vb-in" id="vbCc"><option value="">Choose your country…</option></select>
            <div id="vbRegWrap" hidden>
              <label class="vb-l" for="vbReg" id="vbRegL">State</label>
              <select class="vb-in" id="vbReg"><option value="">Choose…</option></select>
            </div>
            <label class="vb-l" for="vbCity">Nearest town or city <span class="vb-opt">(optional, 15,000+ people)</span></label>
            <input class="vb-in" id="vbCity" autocomplete="off" autocorrect="off" spellcheck="false" placeholder="Start typing, then pick one" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="vbSug" disabled />
            <ul class="vb-sug" id="vbSug" role="listbox" aria-label="Cities" hidden></ul>
            <p class="vb-preview" id="vbPreview" aria-live="polite"></p>
            <div class="vb-btns">
              <button class="ghost-btn vb-sign" id="vbSign" type="submit">Sign it</button>
              <button class="ghost-btn" id="vbSkip" type="button">Not today</button>
            </div>
            <p class="vb-msg" id="vbMsg" aria-live="polite"></p>
          </form>
          <p class="vb-count" id="vbCount"></p>
          <ol class="vb-list" id="vbList" aria-label="Visitors who signed" aria-live="off"></ol>
          <p class="vb-page-status" id="vbPageStatus" role="status" aria-live="polite"></p>
          <nav class="vb-pages" aria-label="Visitors’ Book pages">
            <button class="ghost-btn" id="vbNewer" type="button" disabled>← Newer</button>
            <button class="ghost-btn" id="vbOlder" type="button" disabled>Older →</button>
            <button class="ghost-btn" id="vbRetry" type="button" hidden>Try again</button>
          </nav>
          <div id="vbOwn" hidden><p class="vb-own-label">Your signature</p><ol class="vb-list" id="vbOwnList"></ol></div>
          <p class="vb-credit">Places: GeoNames, CC BY 4.0</p>
        </div>
      </div>
      <button id="scrapClose" class="ghost-btn" type="button">Fold it away →</button>
    </div>
  </div>

  <!-- THE KEEPER'S ROUND: a HUD strip, not an overlay (the room itself is the game) -->
  <div id="roundHud" hidden>
    <div class="rh-row">
      <span id="roundCall" aria-live="polite" aria-atomic="true">Listen…</span>
      <span id="roundClock" role="timer" aria-live="off">75</span>
    </div>
    <div class="rh-row2">
      <span id="roundDots" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
      <button type="button" id="roundQuit" class="ghost-btn">Step back</button>
    </div>
    <span id="roundSr" class="sr-only" aria-live="assertive"></span>
  </div>
  <div id="roundRet" hidden aria-hidden="true"></div>

  <!-- after the clock runs out -->
  <div id="roundEnd" hidden>
    <div class="reward-card" role="dialog" aria-modal="true" aria-labelledby="reKicker">
      <div class="reward-kicker" id="reKicker">THE KEEPER'S ROUND</div>
      <p class="word-line" id="reText">The dark kept them that time. Rest your eyes, then try again.</p>
      <div class="word-actions">
        <button type="button" class="gold-btn" id="reAgain">Try again</button>
        <button type="button" class="ghost-btn" id="reCalm">Try again, no clock</button>
        <button type="button" class="ghost-btn" id="reBack">Step back</button>
      </div>
    </div>
  </div>

  <!-- THE LISTENING LOCK -->
  <div id="lockbox" hidden>
    <div class="reward-card lock-card" role="dialog" aria-modal="true" aria-labelledby="lbKicker">
      <div class="reward-kicker" id="lbKicker">THE LISTENING LOCK</div>
      <p class="word-line lb-line">Three tumblers. Turn the dial and <em>listen</em>: the lock ticks louder and glows warmer as you near the number. Hold still on it and the tumbler falls.</p>
      <div class="lock-dial-wrap">
        <div class="lock-shake" id="lockShake">
          <div class="lock-dial" id="lockDial" tabindex="0" role="slider" aria-label="Combination dial, 0 to 39" aria-valuemin="0" aria-valuemax="39" aria-valuenow="0">
            <div class="ticks"></div><div class="num" id="lockNum">0</div><div class="mark"></div>
          </div>
        </div>
        <div class="dial-steps">
          <button type="button" class="dial-step" id="lockDown" aria-label="Turn down one number">◀</button>
          <p class="lock-heat" id="lockHeat" aria-live="polite" aria-atomic="true">Cold</p>
          <button type="button" class="dial-step" id="lockUp" aria-label="Turn up one number">▶</button>
        </div>
        <div class="lock-tumblers" id="lockTumblers" aria-hidden="true"><i></i><i></i><i></i></div>
      </div>
      <p class="lock-help">Drag the dial, tap the arrows, or use your keyboard's arrow keys.</p>
      <p class="lock-msg" id="lockMsg" aria-live="polite"></p>
      <button type="button" class="ghost-btn" id="lockBack">Step back</button>
    </div>
  </div>

  <!-- A KEY-TILE, taken from the vault -->
  <div id="tilecard" hidden>
    <div class="reward-card" role="dialog" aria-modal="true" aria-labelledby="tcKicker">
      <div class="reward-kicker" id="tcKicker">A KEY-TILE</div>
      <div class="tile-art" id="tcArt"><span>5</span></div>
      <p class="word-line" id="tcText"></p>
      <div class="word-actions">
        <button type="button" class="gold-btn" id="tcClose">Keep exploring →</button>
        <a class="ghost-btn" id="tcPass" href="/passport" hidden>See my passport →</a>
      </div>
    </div>
  </div>

  <!-- Entry gate (enables audio) -->
  <div id="gate">
    <div class="gate-inner">
      <div class="gate-kicker">THE WORD WAS TRUE</div>
      <h1>THE&nbsp;VAULTS</h1>
      <button id="enterBtn">⟡ &nbsp;Step inside</button>
      <a id="gate2d" href="/vault?mode=painted">or explore the painted vault</a>
    </div>
  </div>

  <!-- Reward panel (dynamic — serves all three vaults) -->
  <div id="reward" hidden>
    <div class="reward-card">
      <div class="reward-kicker" id="rwKicker">THE KEEPER'S FIRST GIFT</div>
      <h2 id="rwTitle">FIFTY PUZZLES, YOURS</h2>
      <p id="rwText">No name, no price. Fifty easy puzzles from the Keeper's own desk —
         the first door is open.</p>
      <a class="gold-btn" id="rwBtn" href="#" download>Download the 50 puzzles (PDF)</a>
      <!-- No review ask on any gift card (Dan 2026-11-09, Option B). The neutral ask shows only on
           the front door, on a later visit, to a browser that spoke a book word (public/js/review-ask.js). -->
      <div id="rwGuest"></div>  <!-- a guest key's "the other words are in the book" card (public/js/guest-key.js) -->
      <button id="rewardClose" class="ghost-btn">Keep exploring →</button>
    </div>
  </div>

  <!-- The Keeper's Story — a lifted manuscript page -->
  <div id="pageview" hidden>
    <div class="page-card">
      <div class="page-no" id="pgNo">PAGE ONE</div>
      <p class="page-body" id="pgBody"></p>
      <div class="page-found" id="pgFound">Pages found: 1 of 9</div>
      <button id="pageClose" class="ghost-btn">Set it back down →</button>
    </div>
  </div>

  <!-- Word entry (sealed doors — server-checked, words never in this page) -->
  <div id="wordbox" hidden>
    <div class="reward-card word-card">
      <div class="reward-kicker" id="wbKicker">THE SECOND DOOR</div>
      <p class="word-line" id="wbLine">Say the word.</p>
      <label class="word-label" for="wbInput">Your decoded word</label>
      <p id="wbHint" class="word-hint" data-default-hint="Use the word from your book or cover. Either edition belongs here." data-fourth-hint="The answer to this lock is found only in the original Volume 1: Crack the Keeper’s Vault. It is not included in the Large Print Gift Edition.">Use the word from your book or cover. Either edition belongs here.</p>
      <input id="wbInput" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="32" aria-describedby="wbHint wbMsg" />
      <div class="word-actions">
        <button id="speakBtn" class="ghost-btn" type="button" aria-pressed="false" aria-describedby="wbMicStatus">🎙 <span data-mic-label>Use microphone</span></button>
        <button id="wbSubmit" class="gold-btn">Open the door</button>
        <button id="wbCancel" class="ghost-btn">Step back</button>
      </div>
      <p id="wbMicStatus" class="word-mic-status" role="status" aria-live="polite">You can type the word or use the microphone.</p>
      <div id="wbMsg" role="status" aria-live="polite" aria-atomic="true"></div>
    </div>
  </div>

  <!-- The Keeper's register (initials only, 2-3 letters, by design) -->
  <div id="carvebox" hidden>
    <div class="reward-card word-card">
      <div class="reward-kicker">THE KEEPER'S REGISTER</div>
      <p class="word-line">Leave no name. Names are for the world above. Down here, a mark is enough.</p>
      <input id="cbInput" type="text" autocomplete="off" autocapitalize="characters"
             spellcheck="false" maxlength="3" placeholder="your initials"
             aria-label="Your initials, two or three letters" />
      <label class="cb-age"><input type="checkbox" id="cbAge" /> <span>I am 13 or older.</span></label>
      <div class="word-actions">
        <button id="cbSubmit" class="gold-btn">Carve it</button>
        <button id="cbCancel" class="ghost-btn">Step back</button>
      </div>
      <div id="cbMsg"></div>
    </div>
  </div>

  <script is:inline src="/js/word-microphone.js"></script>
  <FlatVault />

  <!-- THE FAREWELL (2026-11-09) — shown once per tab when a book visitor leaves by "the landing" or the 3D exit
       door. Optional email box + a Continue button; never on a gift card, never on the way in, never for guests.
       Leaving needs nothing typed: Continue goes straight on. -->
  <div id="farewell" hidden>
    <div class="fw-card">
      <DailySignup
        from="vault"
        compact
        kicker="Before you go"
        title="The Keeper writes now and then"
        text="A few free puzzles by email every month or so, and first word when the next vault opens. Optional. Your stamps and pages are kept either way."
        button="Send me puzzles"
      />
      <div class="fw-actions">
        <a class="gold-btn" id="fwGo" href="/">Continue to the landing</a>
        <button type="button" class="ghost-btn" id="fwStay">Stay in the vault</button>
      </div>
    </div>
  </div>
  <script is:inline>
    (function () {
      var fw = document.getElementById('farewell'), go = document.getElementById('fwGo'), stay = document.getElementById('fwStay');
      if (!fw || !go || !stay) return;
      var guest = function () { try { return !!JSON.parse(sessionStorage.getItem('ps_guest_room_v1') || 'null'); } catch (e) { return false; } };
      var seen = function () { try { return sessionStorage.getItem('ps_farewell_v1') === '1'; } catch (e) { return true; } };
      // Returns true when the card was shown (the caller then stays put); false means "just leave".
      window.__vaultFarewell = function (href) {
        if (guest() || seen()) return false;
        try { sessionStorage.setItem('ps_farewell_v1', '1'); } catch (e) {}
        go.href = href || '/';
        fw.hidden = false;
        return true;
      };
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('#backlink, .pv-back') : null;
        if (!a || (a.getAttribute('href') || '') !== '/') return;   // guest rooms rewrite these links; leave those alone
        if (window.__vaultFarewell('/')) e.preventDefault();
      }, true);
      stay.addEventListener('click', function () { fw.hidden = true; });
      // typing an address must never walk the player or light the painted room's hotspots
      fw.addEventListener('keydown', function (e) { e.stopPropagation(); if (e.key === 'Escape') fw.hidden = true; });
    })();
  </script>

  <canvas id="confetti"></canvas>
  <div id="fade"></div>

  <style is:global>
    :root {
      --gold: #f6b23c;
      --gold-dim: #b07c25;
      --parchment: #e8d5ae;
      --ink: #0b0704;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; overflow: hidden; background: var(--ink); }
    body { font-family: 'Cormorant Garamond', serif; color: var(--parchment); }
    #stage, #stage canvas { position: fixed; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }
    #stage::after { /* candlelit vignette — pulls every room toward the concept-art mood */
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(ellipse at 50% 42%, transparent 52%, rgba(8,3,0,0.5) 100%);
    }

    /* ---- HUD ---- */
    #hud { position: fixed; inset: 0; pointer-events: none; z-index: 5; }
    #brand {
      position: absolute; top: 14px; left: 50%; transform: translateX(-50%);
      font-family: Cinzel, serif; font-size: 11px; letter-spacing: 0.32em;
      color: rgba(232,213,174,0.6); white-space: nowrap;
    }
    #brand span { color: var(--gold); }
    #backlink {
      position: absolute; top: 12px; left: 14px; pointer-events: auto;
      font-family: Cinzel, serif; font-size: 10px; letter-spacing: 0.2em;
      color: rgba(232,213,174,0.55); text-decoration: none;
    }
    #backlink:hover { color: var(--gold); }
    #modeChip {
      position: absolute; top: 12px; right: 54px; pointer-events: auto;
      font-family: Cinzel, serif; font-size: 10px; letter-spacing: .14em; text-transform: uppercase;
      color: rgba(232,213,174,.7); text-decoration: none; border: 1px solid rgba(246,178,60,.3);
      border-radius: 999px; padding: 8px 12px; background: rgba(14,10,6,.6);
    }
    #modeChip:hover { color: var(--gold); border-color: rgba(246,178,60,.6); }
    #muteBtn {
      position: absolute; top: 8px; right: 12px; pointer-events: auto;
      background: none; border: 1px solid rgba(246,178,60,0.25); border-radius: 50%;
      width: 34px; height: 34px; color: var(--parchment); font-size: 14px; cursor: pointer;
    }
    #hint {
      position: absolute; bottom: 12px; right: 16px; font-style: italic;
      font-size: 14px; color: rgba(232,213,174,0.45); text-align: right;
    }
    #fwdBtn {
      position: absolute; bottom: 64px; left: 50%; transform: translateX(-50%);
      pointer-events: auto; width: 52px; height: 52px; border-radius: 50%;
      background: rgba(20,12,4,0.55); border: 1px solid rgba(246,178,60,0.4);
      color: var(--gold); font-size: 18px; cursor: pointer; backdrop-filter: blur(2px);
    }
    #fwdBtn:active { background: rgba(246,178,60,0.25); }
    #caption {
      position: absolute; bottom: 0; left: 0; right: 0; padding: 16px 20px 20px;
      text-align: center; pointer-events: none;
      background: linear-gradient(transparent, rgba(5,3,1,0.85));
    }
    #capText {
      font-size: clamp(17px, 2.4vw, 23px); font-style: italic; font-weight: 600;
      color: var(--parchment); text-shadow: 0 1px 8px #000;
      opacity: 0; transition: opacity 0.8s;
    }
    #capText.show { opacity: 1; }
    #label {
      position: absolute; padding: 4px 10px; font-family: Cinzel, serif;
      font-size: 11px; letter-spacing: 0.14em; color: var(--gold);
      background: rgba(10,6,2,0.78); border: 1px solid rgba(246,178,60,0.35);
      border-radius: 3px; white-space: nowrap; display: none;
      transform: translate(-50%, -160%);
    }

    /* ---- gate / panels ---- */
    #gate {
      position: fixed; inset: 0; z-index: 20; display: flex; align-items: center;
      justify-content: center; background: radial-gradient(ellipse at 50% 60%, #1a0f04 0%, #070402 70%);
      transition: opacity 1.4s; text-align: center;
    }
    /* the gate is the painted study the door revealed (arriving from the door skips it entirely) */
    #gate, #fade.from-door { background: #070402 url(/art/rooms/study.webp) center 55% / cover no-repeat; }
    #gate::before { content: ''; position: absolute; inset: 0; background: rgba(4,2,0,.55); }
    #gate .gate-inner { position: relative; }
    #gate.gone { opacity: 0; pointer-events: none; }
    .gate-kicker { font-family: Cinzel, serif; font-size: 11px; letter-spacing: 0.4em; color: var(--gold-dim); margin-bottom: 18px; }
    #gate h1 { font-family: Cinzel, serif; font-weight: 700; font-size: clamp(44px, 9vw, 84px); letter-spacing: 0.18em; color: var(--gold); text-shadow: 0 0 40px rgba(246,178,60,0.35); }
    .gate-sub { font-family: Cinzel, serif; font-size: clamp(14px, 2.4vw, 20px); letter-spacing: 0.34em; color: var(--parchment); margin-top: 10px; }
    .gate-line { font-style: italic; font-size: 17px; color: rgba(232,213,174,0.65); margin: 26px 0 30px; }
    #enterBtn {
      font-family: Cinzel, serif; font-size: 15px; letter-spacing: 0.22em; cursor: pointer;
      color: var(--ink); background: linear-gradient(180deg, #ffd37a, #d99a2b);
      border: none; border-radius: 4px; padding: 15px 38px;
      box-shadow: 0 0 34px rgba(246,178,60,0.35);
    }
    #enterBtn:hover { filter: brightness(1.08); }
    #gate2d {
      display: block; margin: 18px auto 0; font-size: 14px; font-style: italic;
      color: rgba(232,213,174,0.5); text-decoration: underline; text-underline-offset: 3px;
    }
    #gate2d:hover { color: var(--gold); }
    #slowBar {
      position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 30;
      display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px;
      padding: 12px 16px; border-radius: 8px;
      background: rgba(12,8,4,0.94); border: 1px solid rgba(246,178,60,0.4);
      box-shadow: 0 10px 34px rgba(0,0,0,0.7);
      font-size: 14px; font-style: italic; color: rgba(232,213,174,0.85);
    }
    #slowBar .ghost-btn { margin-bottom: 0; width: auto; padding: 10px 16px; min-height: 44px; display: flex; align-items: center; }
    #slowDismiss {
      background: none; border: none; cursor: pointer; min-height: 44px; padding: 0 8px;
      font-family: Cinzel, serif; font-size: 12px; letter-spacing: 0.12em;
      color: rgba(232,213,174,0.5); text-transform: uppercase;
    }
    #slowDismiss:hover { color: var(--gold); }

    #reward, #pageview {
      position: fixed; inset: 0; z-index: 15; display: flex; align-items: center;
      justify-content: center; background: rgba(4,2,0,0.6); backdrop-filter: blur(3px);
    }
    #reward[hidden], #pageview[hidden] { display: none; }

    /* A lifted manuscript page — parchment, not the gold reward card, so lore
       reads as a different kind of find from a treasure. */
    .page-card {
      max-width: 470px; width: calc(100% - 40px); text-align: center;
      background: linear-gradient(180deg, #efe2c4, #ddcaa4);
      border: 1px solid rgba(90,64,26,0.5); border-radius: 3px;
      padding: 34px 34px 26px;
      box-shadow: 0 0 50px rgba(246,178,60,0.16), 0 20px 55px rgba(0,0,0,0.75);
      animation: pageLift 0.42s cubic-bezier(.2,.8,.25,1) both;
    }
    @keyframes pageLift { from { opacity: 0; transform: translateY(26px) rotateX(22deg) scale(.94); } }
    @media (prefers-reduced-motion: reduce) { .page-card { animation: none; } }
    .page-no {
      font-family: Cinzel, serif; font-size: 10px; letter-spacing: 0.38em;
      color: #7a5520; margin-bottom: 14px;
    }
    .page-body {
      font-size: 18px; font-style: italic; line-height: 1.55; color: #2c2011;
      margin-bottom: 20px;
    }
    .page-found {
      font-family: Cinzel, serif; font-size: 10px; letter-spacing: 0.2em;
      color: #8a6a33; margin-bottom: 16px;
    }
    .page-card .ghost-btn { color: #6b4d1f; border-color: rgba(90,64,26,0.45); }
    .page-card .ghost-btn:hover { color: #2c2011; border-color: rgba(90,64,26,0.8); }
    .reward-card {
      max-width: 430px; width: calc(100% - 40px); text-align: center;
      background: linear-gradient(180deg, #1d1207, #120a04);
      border: 1px solid rgba(246,178,60,0.45); border-radius: 8px;
      padding: 34px 30px 28px; box-shadow: 0 0 60px rgba(246,178,60,0.18), 0 18px 50px rgba(0,0,0,0.7);
    }
    .reward-kicker { font-family: Cinzel, serif; font-size: 10px; letter-spacing: 0.38em; color: var(--gold-dim); margin-bottom: 12px; }
    .reward-card h2 { font-family: Cinzel, serif; font-size: 24px; letter-spacing: 0.12em; color: var(--gold); margin-bottom: 12px; }
    .reward-card p { font-size: 17px; font-style: italic; color: rgba(232,213,174,0.8); margin-bottom: 22px; line-height: 1.45; }
    .gold-btn {
      display: block; font-family: Cinzel, serif; font-size: 13px; letter-spacing: 0.16em;
      color: var(--ink); background: linear-gradient(180deg, #ffd37a, #d99a2b);
      border-radius: 4px; padding: 14px 10px; text-decoration: none; margin-bottom: 12px;
      box-shadow: 0 0 24px rgba(246,178,60,0.3); border: none; cursor: pointer;
    }
    .ghost-btn {
      display: block; width: 100%; font-family: Cinzel, serif; font-size: 12px;
      letter-spacing: 0.16em; color: rgba(232,213,174,0.65); background: none;
      border: 1px solid rgba(232,213,174,0.25); border-radius: 4px; padding: 11px 10px;
      cursor: pointer; text-decoration: none;
      min-height: 44px;   /* thumb-sized on touch screens */
    }
    .ghost-btn:hover { color: var(--gold); border-color: rgba(246,178,60,0.5); }

    /* ---- the farewell card (optional email box on the way out) ---- */
    #farewell { position: fixed; inset: 0; z-index: 30; display: flex; overflow-y: auto; padding: 16px;
      background: rgba(4,2,0,0.72); backdrop-filter: blur(3px); }
    #farewell[hidden] { display: none; }
    .fw-card { margin: auto; max-width: 460px; width: 100%; text-align: center;
      background: linear-gradient(180deg, #1d1207, #120a04); border: 1px solid rgba(246,178,60,0.45); border-radius: 8px;
      padding: 26px 20px 20px; box-shadow: 0 0 60px rgba(246,178,60,0.18), 0 18px 50px rgba(0,0,0,0.7); }
    .fw-actions { margin-top: 18px; }
    .fw-actions .gold-btn { margin-bottom: 10px; }

    /* ---- word entry ---- */
    #wordbox { position: fixed; inset: 0; z-index: 16; display: flex; align-items: center;
      justify-content: center; background: rgba(4,2,0,0.65); backdrop-filter: blur(3px); }
    #wordbox[hidden] { display: none; }
    .word-card { max-width: 480px; }
    .word-line { font-size: 18px; font-style: italic; color: rgba(232,213,174,0.85); margin-bottom: 20px; }
    .word-label { display: block; font-size: 16px; color: var(--gold); margin-bottom: 7px; }
    .word-hint { font-size: 15px; line-height: 1.5; color: rgba(232,213,174,0.8); margin: 0 0 14px; }
    #wordbox.shake .word-card { animation: wbshake .45s; }
    @keyframes wbshake { 0%,100%{transform:translateX(0)} 20%{transform:translateX(-9px)} 40%{transform:translateX(8px)} 60%{transform:translateX(-6px)} 80%{transform:translateX(4px)} }
    #wbInput { display: block; box-sizing: border-box; width: 100%; min-width: 0; min-height: 58px;
      border: 1px solid rgba(246,178,60,0.6); border-radius: 6px; background: rgba(20,12,4,0.85);
      padding: 12px; color: var(--gold-hi, #e8cfa0); font: 600 clamp(18px, 4.8vw, 25px)/1.3 Cinzel, serif;
      letter-spacing: .07em; text-align: center; caret-color: var(--gold); }
    #wbInput:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
    .word-actions { display: flex; flex-direction: column; gap: 10px; margin-top: 18px; }
    .cb-age { display: flex; align-items: center; justify-content: center; gap: 8px;
      margin-top: 14px; font-size: 13px; color: var(--gold-hi, #e8cfa0); opacity: .85; cursor: pointer; }
    .cb-age input { width: 15px; height: 15px; accent-color: #b98f52; cursor: pointer; flex: none; }
    .word-actions .gold-btn, .word-actions .ghost-btn { margin-bottom: 0; }
    #wbMsg { min-height: 22px; margin-top: 12px; font-style: italic; font-size: 15px; color: rgba(232,213,174,0.7); }
    #speakBtn.listening, #speakBtn[data-mic-state="listening"] { color: var(--gold); border-color: var(--gold); box-shadow: 0 0 18px rgba(246,178,60,0.35); }
    #carvebox {
      position: fixed; inset: 0; z-index: 15; display: flex; align-items: center;
      justify-content: center; background: rgba(4,2,0,0.6); backdrop-filter: blur(3px);
    }
    #carvebox[hidden] { display: none; }
    #cbInput {
      width: 100%; font-family: Cinzel, serif; font-size: 26px; letter-spacing: 0.5em;
      text-align: center; text-transform: uppercase; color: var(--gold);
      background: rgba(0,0,0,0.45); border: 1px solid rgba(246,178,60,0.4);
      border-radius: 4px; padding: 14px 8px 14px 18px; margin-top: 14px; min-height: 52px;
    }
    #cbInput::placeholder { color: rgba(232,213,174,0.3); letter-spacing: 0.05em; text-transform: none; font-size: 16px; font-style: italic; }
    #cbInput:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 16px rgba(246,178,60,0.3); }
    #cbMsg { min-height: 22px; margin-top: 12px; font-style: italic; font-size: 15px; color: rgba(232,213,174,0.7); }
    @media (max-width: 480px) { .tile { width: 38px; height: 48px; font-size: 21px; } }

    /* ---- the study's own pieces ---- */
    #studyCount {
      position: absolute; top: 40px; left: 50%; transform: translateX(-50%);
      font-family: Cinzel, serif; font-size: 10px; letter-spacing: .24em; color: rgba(232,213,174,.55);
      white-space: nowrap; transition: opacity .6s;
    }
    #studyCount[hidden] { display: none; }
    #studyCount b { color: var(--gold); font-weight: 600; }
    /* a guest room's counter is a GPSr: big enough to see, pointing at the next thing (2026-10-09) */
    #studyCount.gpsr {
      top: 34px; display: flex; align-items: center; gap: 10px; padding: 7px 14px 7px 10px;
      background: rgba(10,6,2,.82); border: 1px solid rgba(246,178,60,.55); border-radius: 8px;
      font-size: 12px; letter-spacing: .12em; color: rgba(232,213,174,.92); pointer-events: none;
      box-shadow: 0 0 18px rgba(246,178,60,.18);
    }
    #studyCount.gpsr[hidden] { display: none; }
    #studyCount.gpsr .g-ttl { font-size: 10px; letter-spacing: .2em; color: #1a1006; background: var(--gold); border-radius: 3px; padding: 2px 5px; }
    #studyCount.gpsr .g-count { color: var(--gold); font-weight: 600; }
    #studyCount.gpsr .g-arr { display: inline-block; color: var(--gold); font-size: 15px; line-height: 1; transition: transform .12s linear; }
    #studyCount.gpsr .g-dist { letter-spacing: .06em; font-family: Georgia, serif; font-style: italic; text-transform: none; }
    #desk, #notebook, #draft {
      position: fixed; inset: 0; z-index: 15; display: flex; align-items: center; justify-content: center;
      background: rgba(4,2,0,0.55); backdrop-filter: blur(2px); padding: 12px;
    }
    #desk[hidden], #notebook[hidden], #draft[hidden] { display: none; }
    /* .ghost-btn sets display, which beat the hidden attribute: the copy button showed (and copied
       the whole position) before a single scrap was found. Found by the 2026-10-01 phone test. */
    #scrapCopy[hidden], #scrapBoard[hidden], #scrapLogPrompt[hidden], #vbBackToPosition[hidden] { display: none !important; }

    /* ---- the key-tile games ---- */
    #roundHud { position: fixed; top: 64px; left: 50%; transform: translateX(-50%); z-index: 12; width: min(560px, 94vw); background: rgba(10,6,2,.86); border: 1px solid rgba(246,178,60,.45); border-radius: 10px; padding: 10px 14px; pointer-events: none; }
    #roundHud[hidden] { display: none; }
    .rh-row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
    #roundCall { font-family: Cinzel, serif; font-weight: 600; font-size: clamp(17px, 2.6vw, 22px); color: #e8d5ae; letter-spacing: .03em; text-align: left; line-height: 1.25; }
    #roundClock { font-family: Cinzel, serif; font-weight: 700; font-size: clamp(20px, 3vw, 26px); color: #ffd37a; min-width: 2.2em; text-align: right; }
    #roundClock.low { color: #ff9a5a; }
    #roundClock.calm { opacity: .35; }
    .rh-row2 { display: flex; align-items: center; justify-content: space-between; margin-top: 6px; }
    #roundDots i { display: inline-block; width: 12px; height: 12px; border-radius: 50%; border: 2px solid rgba(246,178,60,.55); margin-right: 8px; background: rgba(0,0,0,.4); }
    #roundDots i.on { background: #ffd37a; box-shadow: 0 0 10px rgba(246,178,60,.8); border-color: #ffd37a; }
    #roundQuit { pointer-events: auto; width: auto; min-height: 44px; padding: 0 16px; margin: 0; font-size: 12px; display: flex; align-items: center; }
    #roundHud.pulse #roundClock { animation: rhPulse 1s ease-in-out infinite; }
    @keyframes rhPulse { 50% { transform: scale(1.12); } }
    #roundRet { position: fixed; left: 50%; top: 50%; width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%; border: 2px solid rgba(255,224,160,.85); box-shadow: 0 0 8px rgba(246,178,60,.8); z-index: 11; pointer-events: none; }
    #roundRet[hidden] { display: none; }
    body.round #capText { font-size: clamp(20px, 3vw, 28px); }
    #roundEnd, #lockbox, #tilecard { position: fixed; inset: 0; z-index: 15; display: flex; align-items: center; justify-content: center; background: rgba(4,2,0,.6); backdrop-filter: blur(2px); padding: 12px; overscroll-behavior: contain; }
    #roundEnd[hidden], #lockbox[hidden], #tilecard[hidden] { display: none; }
    .lock-card { max-width: 430px; }
    .lock-card .lb-line { font-size: 16.5px; margin-bottom: 10px; }
    .lock-shake { transform: translateX(var(--shake, 0px)); transition: transform .08s linear; }
    .lock-card .lock-dial { --shake: 0px; -webkit-user-select: none; -webkit-touch-callout: none; }
    .dial-steps { display: flex; align-items: center; justify-content: center; gap: 14px; }
    .dial-step { min-width: 48px; min-height: 48px; border-radius: 50%; border: 1px solid rgba(246,178,60,.5); background: rgba(0,0,0,.4); color: #ffd37a; font-size: 16px; cursor: pointer; }
    .lock-heat { min-width: 170px; margin: 0 !important; font-family: Cinzel, serif; font-style: normal !important; font-size: 13px !important; letter-spacing: .12em; text-transform: uppercase; color: rgba(232,213,174,.7) !important; }
    .lock-heat.hot { color: #ffd37a !important; text-shadow: 0 0 10px rgba(246,178,60,.7); }
    #tilecard .tile-art { width: 96px; height: 96px; }
    #tilecard .tile-art span { font: inherit; }
    #tcPass { display: block; text-decoration: none; }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    @media (prefers-reduced-motion: reduce) { #roundHud.pulse #roundClock { animation: none; } .lock-shake { transition: none; } .lock-card .lock-dial { transition: none; } }
    @media (max-width: 640px) { #roundHud { top: 70px; padding: 8px 10px; } }
    #desk { padding: max(6px, env(safe-area-inset-top)) max(6px, env(safe-area-inset-right)) max(6px, env(safe-area-inset-bottom)) max(6px, env(safe-area-inset-left)); overscroll-behavior: contain; }
    /* landscape phones: give the puzzle the height; the ✕ stays as the way out */
    @media (max-height: 480px) {
      #desk { padding: 0; } .desk-card { height: 100vh; height: 100dvh; width: 100%; border-radius: 0; }
      .desk-head { padding: 6px 60px 4px; } .desk-line, .desk-stamps { display: none; } .desk-card .word-actions { display: none; }
    }
    .desk-card {
      width: min(780px, 100%); height: calc(100vh - 12px); height: calc(100dvh - 12px); display: flex; flex-direction: column;
      background: url(/art/parchment_bg.webp) center / cover #e9dcc0; border: 3px solid #3a2a14; border-radius: 4px;
      box-shadow: 0 0 60px rgba(246,178,60,0.18), 0 18px 50px rgba(0,0,0,0.8); overflow: hidden;
    }
    .desk-head { position: relative; padding: 12px 60px 8px; text-align: center; background: rgba(255,250,236,.62); border-bottom: 1px solid rgba(58,42,20,.35); }
    .desk-head .reward-kicker { color: #7a5520; }
    .desk-line { font-size: 17px; font-style: italic; color: #2c2011; line-height: 1.35; }
    .desk-stamps { margin-top: 4px; font-family: Cinzel, serif; font-size: 10px; letter-spacing: .18em; color: #8a6a33; }
    .desk-frame { flex: 1; min-height: 0; display: flex; margin: 0 10px; border: 1px solid rgba(58,42,20,0.6); border-radius: 3px; background: #120d07; }
    .desk-frame iframe { display: block; flex: 1; width: 100%; height: 100%; min-height: 0; border: 0; }
    .desk-x { position: absolute; top: 6px; right: 8px; width: 44px; height: 44px; touch-action: manipulation; border-radius: 50%; border: 1px solid rgba(58,42,20,.6);
      background: #2c2011; color: #f6e7c4; font-size: 18px; line-height: 1; cursor: pointer; }
    .desk-x:hover { background: #4a3418; } .desk-x:focus-visible { outline: 2px solid #b8760c; outline-offset: 2px; }
    .desk-card #deskRise { background: #2c2011; color: #f6e7c4; border-color: #2c2011; }
    .desk-card .word-actions { padding: 8px 10px 10px; margin-top: 0; }
    .desk-card .ghost-btn { color: #6b4d1f; border-color: rgba(90,64,26,.5); }
    #draftA[aria-pressed="true"], #draftB[aria-pressed="true"] { background: rgba(246,178,60,.35); color: #2c2011; border-color: #b8760c; }
    .nb-card, .draft-card { max-width: 520px; }
    .nb-body { text-align: left; min-height: 210px; font-size: 17px; font-style: italic; line-height: 1.5; color: #2c2011; }
    .nb-body h4 { font-family: Cinzel, serif; font-style: normal; font-size: 13px; letter-spacing: .18em; color: #7a5520; margin-bottom: 10px; text-align: center; }
    .nb-body p { margin-bottom: 10px; }
    .nb-body .sketch { display: block; width: 100%; max-height: 220px; object-fit: cover; object-position: 50% 30%; border: 1px solid rgba(90,64,26,.5);
      filter: grayscale(.85) sepia(.6) contrast(.9) brightness(1.05); margin: 6px 0 10px; }
    .nb-body .grid4 { display: grid; grid-template-columns: repeat(4, 32px); gap: 2px; margin: 8px auto; }
    .nb-nav { display: flex; gap: 10px; margin: 6px 0 10px; }
    .nb-nav .ghost-btn { margin: 0; }
    /* the reject: the book's own page (its printed border, the grid in the window, a red stamp) */
    .draft-wrap { display: flex; gap: 18px; align-items: center; max-width: 820px; width: 100%; max-height: calc(100vh - 24px); }
    .sheet { position: relative; flex: none; width: min(400px, 46vw); aspect-ratio: 2550 / 3300; background: #f3ecdb center / cover no-repeat; border-radius: 3px;
      box-shadow: 0 24px 60px rgba(0,0,0,.8), 0 0 40px rgba(246,178,60,.12); animation: pageLift .42s cubic-bezier(.2,.8,.25,1) both; }
