---
import Layout from '../layouts/Layout.astro';
const AMAZON_URL = "https://www.amazon.com/dp/B0HB9K8PXC?tag=genxvsai-20";
// Same @id as the homepage Book node, so both pages describe ONE entity
// rather than two competing ones. The offer URL is deliberately untagged:
// affiliate parameters do not belong inside structured data.
const BOOK_LD = {
  "@context": "https://schema.org",
  "@type": "Book",
  "@id": "https://puzzlesecret.com/#book-v1",
  "name": "Sudoku with a Secret, Volume 1: Crack the Keeper's Vault",
  "alternateName": "Sudoku with a Secret",
  "bookFormat": "https://schema.org/Paperback",
  "author": { "@type": "Person", "name": "Dan Herlehy" },
  "publisher": { "@type": "Organization", "name": "PuzzleSecret" },
  "isbn": "9798188603960",
  "inLanguage": "en",
  "numberOfPages": 252,
  "datePublished": "2026-07-24",
  "genre": ["Puzzles", "Sudoku", "Logic and Brain Teasers"],
  "image": "https://puzzlesecret.com/art/door-v10.webp",
  "description": "200 honest Sudoku puzzles (70 Easy, 80 Medium, 50 Hard), one full-page 9x9 grid per 8.5 x 11 inch page. Twenty hide a shaded cipher digit; decode the words they spell to open three online vaults of free bonus puzzles. Answer keys and a new-to-Sudoku primer included.",
  "url": "https://puzzlesecret.com/shop",
  "offers": {
    "@type": "Offer",
    "price": "14.99",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "url": "https://www.amazon.com/dp/B0HB9K8PXC"
  }
};
---

<Layout title="The Keeper's Commissary · PuzzleSecret Shop" description="Get Sudoku with a Secret Volume 1 on Amazon or download standalone bonus puzzle packs from the Keeper's commissary.">
  <main class="page-shop">
    <script type="application/ld+json" set:html={JSON.stringify(BOOK_LD)} />
    <div class="shop-hero">
      <p class="eyebrow">The Commissary</p>
      <h1>Books &amp; Vault Rewards</h1>
      <p class="lede">Order the physical book on Amazon to start the hunt, or redeem discount codes earned by cracking the vaults.</p>
    </div>

    <section class="wrap shop-grid">
      <!-- Volume 1 Featured Book Card -->
      <article class="product-card featured">
        <div class="badge-tag">VOLUME 1 · AVAILABLE NOW</div>
        <div class="prod-split">
          <div class="prod-img-wrap">
            <img src="/art/door-v10.webp" alt="Sudoku with a Secret — Volume 1 Cover" width="360" height="520" class="prod-cover" />
          </div>
          <div class="prod-details">
            <h2>Sudoku with a Secret</h2>
            <p class="sub">Volume I: The Keeper's Vault — by Dan Herlehy</p>
            <div class="price-tag">$14.99 <span class="format">Paperback (8.5" × 11")</span></div>
            <ul class="feat-list">
              <li>✦ 200 honest Sudoku puzzles (70 Easy, 80 Medium, 50 Hard)</li>
              <li>✦ 20 secret key puzzles hiding shaded cipher digits</li>
              <li>✦ 3 escalating decode acts opening 3 web vaults</li>
              <li>✦ Unlocks up to 350 free bonus puzzles on this site</li>
              <li>✦ Full answer keys included in the back</li>
            </ul>
            <a href={AMAZON_URL} target="_blank" rel="noopener" class="btn-buy">
              Buy Volume 1 on Amazon ↗
            </a>
            <p class="sub-fine">Dispatched globally via Amazon Prime POD</p>
          </div>
        </div>
      </article>

      <!-- Vault Winner Coupon — teaser (redemption opens with the Commissary) -->
      <article class="redeem-card">
        <div class="redeem-inner">
          <h3>Cracked a Vault? Your Discount Is Waiting.</h3>
          <p>
            Every vault you open in <em>The Keeper's Vault</em> earns a discount &mdash;
            <strong>10%</strong>, <strong>20%</strong>, then <strong>30%</strong> off &mdash;
            to be honoured when the Keeper's Commissary opens for direct orders.
          </p>
          <p class="redeem-note">
            Meanwhile, every bonus puzzle pack below is <strong>already free</strong> &mdash;
            no code, no email, no catch.
          </p>
          <a class="c-btn" href="/vault">Enter the Vaults &rarr;</a>
        </div>
      </article>

      <!-- Digital Bonus Packs -->
      <div class="section-head">
        <h2>The Keeper's Gifts</h2>
        <p>Handed over inside the vaults when you crack them &mdash; and open to anyone here. The stamps, key-tiles and certificate are the part you have to earn.</p>
      </div>

      <div class="packs-grid">
        <article class="pack-card">
          <div class="p-rn">I</div>
          <h3>50 Easy Puzzles</h3>
          <p>The Keeper's First Gift — 50 printable easy puzzles with answer key PDF.</p>
          <div class="p-status free">THE GIFT OF VAULT I</div>
          <a href="/rewards/PuzzleSecret-Vault-I-50-Easy.pdf" download class="btn-download">Download PDF (Free)</a>
        </article>

        <article class="pack-card">
          <div class="p-rn">II</div>
          <h3>100 Medium Puzzles</h3>
          <p>The Library of Puzzles — 100 printable medium puzzles for seasoned solvers.</p>
          <div class="p-status">THE GIFT OF VAULT II</div>
          <a href="/rewards/PuzzleSecret-Vault-II-100-Medium.pdf" download class="btn-download">Download PDF (Free)</a>
        </article>

        <article class="pack-card">
          <div class="p-rn">III</div>
          <h3>200 Hard Puzzles</h3>
          <p>The Grand Vault — 200 hard printable puzzles, the ultimate hoard.</p>
          <div class="p-status">THE GIFT OF VAULT III</div>
          <a href="/rewards/PuzzleSecret-Vault-III-200-Hard.pdf" download class="btn-download">Download PDF (Free)</a>
        </article>
      </div>

      <!-- Upcoming Volumes Teasers -->
      <div class="section-head soon-head">
        <h2>Upcoming Volumes in the Series</h2>
        <p>Four more books are being written. Each book holds a different secret.</p>
      </div>

      <div class="soon-grid">
        <div class="s-card v2">
          <img src="/teasers/v2.webp" alt="Volume II" loading="lazy" />
          <h4>Volume II</h4>
          <p>The Corsair's Chart</p>
          <span class="s-badge">Coming Soon</span>
        </div>
        <div class="s-card v3">
          <img src="/teasers/v3.webp" alt="Volume III" loading="lazy" />
          <h4>Volume III</h4>
          <p>The Lost Love Letters</p>
          <span class="s-badge">Coming Soon</span>
        </div>
        <div class="s-card v4">
          <img src="/teasers/v4.webp" alt="Volume IV" loading="lazy" />
          <h4>Volume IV</h4>
          <p>The Silent Signal</p>
          <span class="s-badge">Coming Soon</span>
        </div>
        <div class="s-card v5">
          <img src="/teasers/v5.webp" alt="Volume V" loading="lazy" />
          <h4>Volume V</h4>
          <p>The Hollow Oak</p>
          <span class="s-badge">Coming Soon</span>
        </div>
      </div>
    </section>
  </main>

  <!-- NOTE: the old client-side "coupon validator" was removed 2026-07-28.
       It was fake (substring matching) AND it shipped the secret words + a
       "CLEVER10" placeholder into the page source, spoiling the hunt.
       Real redemption arrives with Stripe Checkout — server-side only.
       NEVER put a secret word in client code. -->

  <style>
    .page-shop { padding-top: 90px; padding-bottom: 80px; }
    .shop-hero { text-align: center; max-width: 680px; margin: 0 auto 48px; padding: 0 20px; }
    .eyebrow { font-family: var(--display); font-size: 11px; letter-spacing: .36em; text-transform: uppercase; color: var(--gold); margin-bottom: 12px; }
    .shop-hero h1 { font-family: var(--display); font-size: clamp(32px, 5.5vw, 54px); font-weight: 600; color: var(--ivory); line-height: 1.1; margin-bottom: 14px; }
    .lede { font-size: clamp(16px, 2vw, 19px); font-style: italic; color: var(--ash); line-height: 1.45; }

    .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
    .shop-grid { display: flex; flex-direction: column; gap: 48px; }

    .product-card.featured { background: linear-gradient(180deg, #141218, #0c0b0f); border: 1px solid rgba(246,178,60,.4); border-radius: 14px; padding: 36px; position: relative; box-shadow: 0 10px 40px rgba(0,0,0,.6); }
    .badge-tag { position: absolute; top: -13px; left: 32px; background: linear-gradient(180deg, var(--gold-hi), var(--gold)); color: #1a1206; font-family: var(--display); font-size: 10px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; padding: 4px 14px; border-radius: 999px; box-shadow: 0 4px 12px rgba(246,178,60,.4); }
    .prod-split { display: grid; grid-template-columns: 300px 1fr; gap: 40px; align-items: center; }
    .prod-img-wrap { text-align: center; }
    .prod-cover { max-width: 100%; height: auto; border-radius: 8px; box-shadow: 0 8px 30px rgba(0,0,0,.8); border: 1px solid rgba(246,178,60,.2); }
    .prod-details h2 { font-family: var(--display); font-size: clamp(26px, 4vw, 36px); color: var(--gold-hi); margin-bottom: 6px; }
    .prod-details .sub { font-style: italic; color: var(--ash); font-size: 16px; margin-bottom: 16px; }
    .price-tag { font-family: var(--display); font-size: 28px; font-weight: 700; color: var(--ivory); margin-bottom: 20px; }
    .price-tag .format { font-size: 13px; font-weight: 400; color: var(--ash); margin-left: 10px; }
    .feat-list { list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 15.5px; color: var(--ivory); margin-bottom: 28px; }
    .btn-buy { display: inline-block; padding: 16px 36px; font-family: var(--display); font-weight: 700; font-size: 13px; letter-spacing: .22em; text-transform: uppercase; color: #1a1206; background: linear-gradient(180deg, var(--gold-hi), var(--gold)); border-radius: 8px; box-shadow: 0 8px 24px rgba(246,178,60,.35); transition: transform .2s, box-shadow .2s; }
    .btn-buy:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(246,178,60,.5); }
    .sub-fine { font-size: 12px; font-style: italic; color: var(--ash-dim); margin-top: 10px; }

    .redeem-card { background: rgba(185,143,82,.06); border: 1px dashed rgba(246,178,60,.35); border-radius: 12px; padding: 30px; text-align: center; }
    .redeem-inner h3 { font-family: var(--display); font-size: 20px; color: var(--gold); margin-bottom: 8px; }
    .redeem-inner p { font-style: italic; color: var(--ash); margin-bottom: 20px; max-width: 560px; margin-left: auto; margin-right: auto; }
    .coupon-form { display: flex; gap: 10px; justify-content: center; max-width: 480px; margin: 0 auto; }
    .c-input { flex: 1; padding: 12px 16px; border: 1px solid rgba(185,143,82,.4); border-radius: 6px; background: rgba(10,10,12,.8); color: var(--gold-hi); font-family: var(--display); font-size: 14px; outline: none; }
    .redeem-note { font-size: 15px; }
    .redeem-note strong { color: var(--gold-hi); font-style: normal; }
    .c-btn { display: inline-block; text-decoration: none; padding: 12px 24px; background: var(--brass); color: #110d06; font-family: var(--display); font-weight: 600; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; border: none; border-radius: 6px; cursor: pointer; transition: background .2s; }
    .c-btn:hover { background: var(--brass-hi); }
    .c-msg { margin-top: 14px; font-style: italic; font-size: 14px; }

    .section-head { text-align: center; margin-top: 20px; }
    .section-head h2 { font-family: var(--display); font-size: 24px; color: var(--gold); margin-bottom: 6px; }
    .section-head p { font-style: italic; color: var(--ash); }

    .packs-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
    .pack-card { background: #121016; border: 1px solid rgba(185,143,82,.25); border-radius: 10px; padding: 26px; text-align: center; display: flex; flex-direction: column; justify-content: space-between; }
    .p-rn { font-family: var(--display); font-size: 28px; font-weight: 700; color: var(--gold); opacity: .7; margin-bottom: 8px; }
    .pack-card h3 { font-family: var(--display); font-size: 20px; color: var(--ivory); margin-bottom: 8px; }
    .pack-card p { font-style: italic; font-size: 14.5px; color: var(--ash); margin-bottom: 20px; }
    .p-status { font-family: var(--display); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--gold); margin-bottom: 14px; }
    .p-status.free { color: var(--v2); }
    .btn-download { display: block; padding: 12px; border: 1px solid rgba(246,178,60,.4); border-radius: 6px; color: var(--gold-hi); font-family: var(--display); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; transition: background .2s; }
    .btn-download:hover { background: rgba(246,178,60,.15); }

    .soon-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
    .s-card { background: #0e0d12; border: 1px solid rgba(255,255,255,.08); border-radius: 10px; padding: 20px; text-align: center; }
    .s-card img { width: 100%; height: auto; border-radius: 6px; margin-bottom: 12px; opacity: .75; }
    .s-card h4 { font-family: var(--display); font-size: 15px; color: var(--ivory); }
    .s-card p { font-style: italic; font-size: 13px; color: var(--ash); margin-bottom: 10px; }
    .s-badge { display: inline-block; font-family: var(--display); font-size: 9px; letter-spacing: .2em; text-transform: uppercase; padding: 3px 10px; border-radius: 999px; background: rgba(154,146,127,.2); color: var(--ash); }

    @media (max-width: 768px) {
      .prod-split { grid-template-columns: 1fr; }
      .coupon-form { flex-direction: column; }
    }
  </style>
</Layout>
