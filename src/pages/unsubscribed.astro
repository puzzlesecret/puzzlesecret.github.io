---
// The landing page every Dispatch unsubscribe link points at (dispatch-mailer.gs footer_ → /unsubscribed/?t=…;
// links to the old /api/unsubscribe?t=… address are forwarded here too).
//
// ONE CONFIRM BUTTON, NEVER REMOVAL ON PAGE LOAD (fixed 2026-11-09). Mail clients and security appliances
// prefetch links, and a forwarded issue carries the original reader's link — so loading this page changes
// nothing. The reader presses one button, which POSTs to /api/unsubscribe. CAN-SPAM allows a single page with
// one action. Works with or without JavaScript: the page is rendered on request (prerender = false), so the
// token and the ?state= coming back from the no-JS form post are both in the HTML.
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const q = Astro.url.searchParams;
const token = (q.get('t') || '').trim().slice(0, 200);
// ?state=done / ?state=error come back from the no-JS <form> post.
const state = q.get('state') || '';
const DONE = 'Your address has been struck from the register. No further Dispatch will reach you.';
const ERR = 'The register could not be reached just now. Please press the button once more.';
const ASK = 'Press the button below and your address is struck from the Keeper’s register. Nothing else to fill in.';
const NOTOKEN = 'That link is missing its token. Reply to any Dispatch with the word “unsubscribe” and it will be handled by hand.';
const status = state === 'done' ? DONE : state === 'error' ? ERR : token ? ASK : NOTOKEN;
const showButton = state !== 'done' && !!token;
---

<Layout
  title="Leaving the Dispatch · PuzzleSecret"
  description="Remove your address from the Keeper's Dispatch."
  noindex={true}
>
  <main class="page-unsub">
    <div class="wrap">
      <div class="parchment-card">
        <div class="seal-mark">✦</div>
        <h1>The Keeper's Dispatch</h1>

        <p class="status" id="status" data-state={state}>{status}</p>

        {showButton && (
          <form method="POST" action="/api/unsubscribe" class="unsub-form" id="unsubForm">
            <input type="hidden" name="t" value={token} />
            <button type="submit" class="n-btn" id="unsubBtn">Unsubscribe me</button>
          </form>
        )}

        <p class="tail">
          The vaults stay open regardless — the free puzzles on <a href="/play">the play page</a> and every
          vault gift were never gated behind email.
        </p>
      </div>
    </div>
  </main>

  <script>
    // With JavaScript the same button posts in place (no page reload). Without it, the form above posts
    // and /api/unsubscribe redirects back here with ?state=done or ?state=error.
    const form = document.getElementById('unsubForm') as HTMLFormElement | null;
    const el = document.getElementById('status');
    const btn = document.getElementById('unsubBtn') as HTMLButtonElement | null;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!el || !btn) return;
      const t = (form.querySelector('input[name="t"]') as HTMLInputElement | null)?.value || '';
      btn.disabled = true;
      el.dataset.state = '';
      el.textContent = 'Striking your address from the register…';
      try {
        const res = await fetch('/api/unsubscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ t }),
        });
        const data = await res.json().catch(() => ({}));
        if (data && data.ok) {
          el.dataset.state = 'done';
          el.textContent = 'Your address has been struck from the register. No further Dispatch will reach you.';
          form.hidden = true;
          return;
        }
      } catch { /* fall through */ }
      el.dataset.state = 'error';
      el.textContent = 'The register could not be reached just now. Please press the button once more.';
      btn.disabled = false;
    });
  </script>

  <style>
    .page-unsub { padding-top: 110px; padding-bottom: 90px; }
    .wrap { max-width: 620px; margin: 0 auto; padding: 0 20px; }

    .parchment-card { background: linear-gradient(180deg, #16121a, #0d0a10); border: 1px solid rgba(246,178,60,.35); border-radius: 14px; padding: 46px 32px; text-align: center; box-shadow: 0 10px 40px rgba(0,0,0,.6); }
    .seal-mark { font-size: 32px; color: var(--gold); margin-bottom: 12px; }
    .parchment-card h1 { font-family: var(--display); font-size: clamp(24px, 4vw, 30px); font-weight: 600; color: var(--gold-hi); margin-bottom: 18px; }

    .status { font-style: italic; font-size: 16.5px; color: var(--ash); line-height: 1.55; min-height: 52px; }
    .status[data-state="done"] { color: var(--gold-hi); }
    .status[data-state="error"] { color: #e08d7a; }

    .unsub-form { margin-top: 22px; }
    .unsub-form[hidden] { display: none; }
    .n-btn { padding: 14px 24px; min-height: 44px; background: linear-gradient(180deg, var(--gold-hi), var(--gold)); color: #1a1206; font-family: var(--display); font-weight: 700; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; border: none; border-radius: 8px; cursor: pointer; transition: transform .2s; }
    .n-btn:hover { transform: translateY(-1px); }
    .n-btn:disabled { opacity: .6; cursor: default; }

    .tail { margin-top: 28px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,.06); font-size: 14px; color: var(--ash-dim); line-height: 1.6; }
    .tail a { color: var(--brass-hi); }

    @media (max-width: 520px) { .parchment-card { padding: 36px 20px; } }
  </style>
</Layout>
