---
import Layout from '../layouts/Layout.astro';
const FAQ_LD = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What makes Sudoku with a Secret different from regular Sudoku books?", "acceptedAnswer": {"@type": "Answer", "text": "Every puzzle in the book is a high-quality, honest Sudoku solvable with logic alone. But hidden among them are puzzles with a single shaded cell; the digits in those shaded cells spell out passwords that unlock 3 secret vaults on this website."}}, {"@type": "Question", "name": "I've never done a sudoku. Where do I start?", "acceptedAnswer": {"@type": "Answer", "text": "With the one rule: every row, column and 3x3 box holds the digits 1 to 9 exactly once. Our free how-to-play-sudoku guide teaches it in two minutes, then Puzzle 1 on the Play page is an easy first grid. The book also opens with a Start Here page and 70 easy puzzles."}}, {"@type": "Question", "name": "Are the answer keys included in the book?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Full answer keys for all 200 puzzles are included in the back of the book, alongside an enciphered spoiler-protection key."}}, {"@type": "Question", "name": "What if I get stuck on a secret word?", "acceptedAnswer": {"@type": "Answer", "text": "Visit the Hint Chamber for progressive, spoiler-free clues that help you find the key digits and decode the words without ruining the surprise."}}, {"@type": "Question", "name": "Do I have to enter my email to get the vault reward PDFs?", "acceptedAnswer": {"@type": "Answer", "text": "No. Email is strictly optional. When you crack a vault, your reward PDF (50 Easy, 100 Medium, or 200 Hard puzzles) is available for direct instant download. Rewards are never gated behind email."}}, {"@type": "Question", "name": "Is this website safe for kids?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. PuzzleSecret contains zero tracking scripts, zero third-party ads, zero dark patterns, and zero external font tracking. All font assets are self-hosted. The puzzles themselves suit any age, but our newsletter and the Keeper's Register are for solvers aged 13 and over, and we never ask any visitor for their age, school or location."}}, {"@type": "Question", "name": "Was any of this made with AI?", "acceptedAnswer": {"@type": "Answer", "text": "The artwork was, and the puzzles were not. The vault illustrations on this site and the engraved border art in the book were created with Google Gemini and then hand-edited. Everything that makes the book work — all 200 Sudoku puzzles, the ciphers, the Keeper's letters and the hunt itself — was built and verified by a human. Every puzzle is machine-checked to have exactly one solution."}}, {"@type": "Question", "name": "Where can I buy Volume 1?", "acceptedAnswer": {"@type": "Answer", "text": "Volume 1 is available in paperback on Amazon worldwide."}}]};
const AMAZON_URL = "https://www.amazon.com/dp/B0HB9K8PXC?tag=puzzlesecret-20";
---

<Layout title="Frequently Asked Questions · PuzzleSecret" description="Find answers to common questions about Sudoku with a Secret, vault rewards, PDF downloads, and ordering.">
  <script type="application/ld+json" set:html={JSON.stringify(FAQ_LD)} />
  <main class="page-faq">
    <div class="faq-hero">
      <p class="eyebrow">Questions &amp; Answers</p>
      <h1>Frequently Asked Questions</h1>
      <p class="lede">Everything you need to know about the secret mechanics, reward PDFs, digital privacy, and buying the book.</p>
    </div>

    <section class="wrap faq-body">
      <div class="faq-group">
        <h2>The Secret Mechanic &amp; Book</h2>
        <details class="faq-card">
          <summary>What makes Sudoku with a Secret different from regular Sudoku books?</summary>
          <div class="faq-ans">
            <p>Every puzzle in the book is a high-quality, honest Sudoku puzzle solvable with logic alone. However, hidden among them are puzzles with a single shaded cell. The digits inside those shaded cells spell out passwords that unlock 3 secret vaults on this website!</p>
          </div>
        </details>
        <details class="faq-card">
          <summary>I've never done a sudoku. Where do I start?</summary>
          <div class="faq-ans">
            <p>With the one rule: every row, column and 3&times;3 box holds the digits 1 to 9 exactly once. <a href="/how-to-play-sudoku">Learn how to play sudoku</a> in two minutes, then try <a href="/play">Puzzle 1</a> &mdash; an easy first grid. The book also opens with a Start Here page and 70 easy puzzles.</p>
          </div>
        </details>
        <details class="faq-card">
          <summary>Are the answer keys included in the book?</summary>
          <div class="faq-ans">
            <p>Yes! Full answer keys for all 200 puzzles are included in the back of the book, alongside an enciphered spoiler protection key.</p>
          </div>
        </details>
        <details class="faq-card">
          <summary>What if I get stuck on a secret word?</summary>
          <div class="faq-ans">
            <p>You can visit our <a href="/hints" style="color:var(--gold)">Hint Chamber</a> for progressive, spoiler-free clues that help you find the key digits and decode the words without ruining the surprise.</p>
          </div>
        </details>
      </div>

      <div class="faq-group">
        <h2>Vault Rewards &amp; PDF Downloads</h2>
        <details class="faq-card">
          <summary>Do I have to enter my email to get the vault reward PDFs?</summary>
          <div class="faq-ans">
            <p>No! Email is strictly optional. When you crack a vault, your reward PDF (50 Easy, 100 Medium, or 200 Hard puzzles) is available for direct instant download. We never gate your rewards behind email collection.</p>
          </div>
        </details>
      </div>

      <div class="faq-group">
        <h2>Privacy, Kid Safety &amp; Orders</h2>
        <details class="faq-card">
          <summary>Is this website safe for kids?</summary>
          <div class="faq-ans">
            <p>Yes. PuzzleSecret contains zero tracking scripts, zero third-party ads, zero dark patterns, and zero external font tracking. All font assets are self-hosted directly on our servers. The puzzles themselves suit any age, but our newsletter and the Keeper's Register are for solvers aged 13 and over, and we never ask any visitor for their age, school or location.</p>
          </div>
        </details>
        <details class="faq-card">
          <summary>Do you log anything about my visit?</summary>
          <div class="faq-ans">
            <p>Only the site's own events, and only in the Keeper's own log. When you arrive, speak a word, open a reward, pick up a tile, open the hints page, solve a free puzzle, work through the guided first puzzle, reach the last room or carve initials on the register, the site tells the author's private Telegram: a random 4-character solver tag (not a name, not an email, not an IP), your country (and for U.S./Canada visitors, a two-letter state or province — never a city), phone or desktop, which of our pages you visit, the name of the site that sent you here (never the page you came from), and the event itself. A wrong vault guess is passed along as bare letters; nothing else you type ever is. No cookies, no advertising trackers, nothing sold or shared with anyone else. (The site also runs Vercel's cookieless analytics, which counts page views in aggregate and never identifies you.) Clear this browser's storage and the tag resets. Section 2 of our <a href="/privacy">privacy policy</a> sets out everything the log records.</p>
          </div>
        </details>
        <details class="faq-card">
          <summary>Was any of this made with AI?</summary>
          <div class="faq-ans">
            <p>The artwork was, and the puzzles were not. The vault illustrations on this site and the engraved border art in the book were created with Google Gemini and then hand-edited. Everything that makes the book work — all 200 Sudoku puzzles, the ciphers, the Keeper's letters and the hunt itself — was built and verified by a human. Every puzzle is machine-checked to have exactly one solution.</p>
          </div>
        </details>
        <details class="faq-card">
          <summary>Where can I buy Volume 1?</summary>
          <div class="faq-ans">
            <p>Volume 1 is available in paperback on <a href={AMAZON_URL} target="_blank" rel="noopener" style="color:var(--gold)">Amazon Prime</a> worldwide.</p>
          </div>
        </details>
      </div>
    </section>
  </main>

  <style>
    .page-faq { padding-top: 90px; padding-bottom: 80px; }
    .faq-hero { text-align: center; max-width: 640px; margin: 0 auto 40px; padding: 0 20px; }
    .eyebrow { font-family: var(--display); font-size: 11px; letter-spacing: .36em; text-transform: uppercase; color: var(--gold); margin-bottom: 12px; }
    .faq-hero h1 { font-family: var(--display); font-size: clamp(32px, 5.5vw, 50px); font-weight: 600; color: var(--ivory); line-height: 1.1; margin-bottom: 14px; }
    .lede { font-size: clamp(16px, 2vw, 19px); font-style: italic; color: var(--ash); line-height: 1.45; }

    .wrap { max-width: 780px; margin: 0 auto; padding: 0 20px; }

    .faq-group { margin-bottom: 40px; }
    .faq-group h2 { font-family: var(--display); font-size: 20px; color: var(--gold); margin-bottom: 16px; border-bottom: 1px solid rgba(185,143,82,.2); padding-bottom: 8px; }

    .faq-card { background: #121016; border: 1px solid rgba(185,143,82,.2); border-radius: 8px; margin-bottom: 12px; padding: 16px 20px; }
    .faq-card summary { font-family: var(--display); font-size: 15px; color: var(--ivory); cursor: pointer; list-style: none; }
    .faq-card summary::-webkit-details-marker { display: none; }
    .faq-ans a { color: var(--gold); text-decoration: underline; }
    .faq-ans { margin-top: 12px; padding-top: 10px; border-top: 1px solid rgba(255,255,255,.05); font-size: 15.5px; line-height: 1.55; color: var(--ash); }
  </style>
</Layout>
