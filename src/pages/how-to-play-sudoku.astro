---
import Layout from '../layouts/Layout.astro';
import SeriesStrip from '../components/SeriesStrip.astro';
import webPuzzles from '../data/web_puzzles.json';
import { buildMoves } from '../lib/guided-solve.js';
const AMAZON_URL = "https://www.amazon.com/dp/B0HB9K8PXC?tag=puzzlesecret-20";

// The beginner page, rebuilt 2026-09-19 (plan + ten critiques:
// _content/HOW-TO-PLAY-REBUILD-PLAN-2026-09-19.md). One path, in this order: the rule, a
// picture, the GUIDED FIRST PUZZLE (Puzzle 1, the one in the video, every move with its
// reason), the real-footage video, the written guide, the printable sheet. Everything the
// widget says is also in the HTML as plain text, so crawlers and AI engines that run no
// JS still get all 42 moves.
const YOUTUBE_ID = "wptFDC3qa2Y";
const PAGE_TITLE = "How to Play Sudoku for Beginners: Rules + a Guided First Puzzle";
const PAGE_DESC = "Sudoku in one rule: 1 to 9 in every row, column and 3×3 box, no repeats. No maths, no guessing. Learn it by doing: a guided first puzzle that explains every move, a real lesson on video, and a printable cheat sheet.";
const UPDATED = "2026-09-19";

const P1 = webPuzzles[0];
const MOVES = buildMoves(P1.givens, P1.solution);
const GIVENS = P1.givens.split('').map(Number);
const N_ONLY = MOVES.filter((m) => m.kind === 'only').length;
const N_LAST = MOVES.length - N_ONLY;
const TEACH = 8;      // moves shown with the reason before the learner takes over
const MID = 12;       // where the book card appears ("Oh good. Now I can do it.")

// A static grid for the pictures. hl: {cell: 'unit'|'block'|'target'|'out'}; show: extra digits.
function gridCells(state, hl = {}, placed = {}) {
  return state.map((d, i) => ({ i, d: placed[i] || d, given: !!d, placed: !!placed[i], cls: hl[i] || '' }));
}
const M0 = MOVES[0];
const stateAt = (n) => { const g = [...GIVENS]; MOVES.slice(0, n).forEach((m) => { g[m.cell] = m.digit; }); return g; };
const hlUnit = Object.fromEntries(M0.unit.map((c) => [c, 'unit']));
const M0_OUT = M0.unit.filter((c) => GIVENS[c] === 0 && c !== M0.cell);
const FRAMES = [
  { cap: `1. Pick a box and a missing number. Here: the ${M0.digit} in the tinted box.`, cells: gridCells(GIVENS, hlUnit) },
  { cap: `2. Find every ${M0.digit} that looks into that box along a row or column. Each one rules squares out.`, cells: gridCells(GIVENS, { ...hlUnit, ...Object.fromEntries(M0_OUT.map((c) => [c, 'out'])), ...Object.fromEntries(M0.blockers.map((c) => [c, 'block'])) }) },
  { cap: `3. One empty square is left. It is certain, so write the ${M0.digit} in.`, cells: gridCells(GIVENS, { ...hlUnit, [M0.cell]: 'target' }, { [M0.cell]: M0.digit }) },
];
const LASTI = MOVES.findIndex((m) => m.kind === 'last');
const ML = MOVES[LASTI];
const FRAME_LAST = { cells: gridCells(stateAt(LASTI), { ...Object.fromEntries(ML.unit.map((c) => [c, 'unit'])), [ML.cell]: 'target' }) };
const RULE_HL = {};
for (let i = 0; i < 81; i++) {
  const r = Math.floor(i / 9), c = i % 9;
  if (r === 1) RULE_HL[i] = 'rowhl';
  if (c === 7) RULE_HL[i] = RULE_HL[i] ? 'bothhl' : 'colhl';
  if (r >= 6 && c <= 2) RULE_HL[i] = 'boxhl';
}
const RULE_CELLS = gridCells(GIVENS, RULE_HL);

const CHAPTERS = [
  { t: 0, label: "The one rule, at the kitchen table" },
  { t: 95, label: "Picking the fullest box" },
  { t: 170, label: "The first certain number" },
  { t: 330, label: "Why you never write a guess" },
  { t: 520, label: "Stuck: switching from boxes to rows" },
  { t: 800, label: "The last numbers, and checking the work" },
];
const SHOW_CHAPTERS = false; // flip on once the offsets are checked against the upload

const MYTHS = [
  ["Sudoku is a maths puzzle.", "Sudoku uses no arithmetic. The digits are nine different symbols; letters, colours or fruit would work the same way."],
  ["Sooner or later you have to guess.", "A properly made Sudoku never needs a guess. Every number can be placed for a reason. Harder puzzles need more reasons than this page teaches, but never a coin flip."],
  ["The diagonals matter.", "In classic Sudoku only rows, columns and 3×3 boxes count. Diagonals are ignored."],
  ["A Sudoku can have several right answers.", "A valid Sudoku has exactly one solution. If two answers fit, the puzzle was badly made."],
  ["Writing small notes is cheating.", "Small pencilled notes are a normal part of Sudoku. Experts use them on every hard puzzle."],
  ["If I am stuck, the puzzle is broken.", "Being stuck in Sudoku almost always means there is a certain number you have not spotted yet, usually in a row or column you have not checked."],
];

const STUCK = [
  "Look for any row, column or box with only one or two gaps. Those are the cheapest numbers on the grid.",
  "Pick the digit that appears most often on the grid (count the 1s, the 2s...). The more copies there are, the fewer places the rest can go.",
  "Go round every box asking question one for that digit: where can it go in this box?",
  "Switch shape. If you have been working in boxes, ask the same question of a row or a column.",
  "Recheck the last number you placed: its row, its column and its box. New numbers open new moves right next to them.",
  "Still stuck on a harder puzzle? Pencil tiny notes into squares that have only two possible numbers, then go round again.",
];

const GLOSSARY = [
  ["square", "Square (or cell)", "One of the 81 small spaces in a Sudoku grid. Each square holds one digit."],
  ["row", "Row", "A line of nine squares running left to right. A Sudoku has nine rows."],
  ["column", "Column", "A line of nine squares running top to bottom. A Sudoku has nine columns."],
  ["box", "Box", "One of the nine 3×3 blocks marked by thicker lines. Also called a block or region."],
  ["given", "Given", "A digit printed in the grid at the start. Givens never change."],
  ["only-place", "Only place (hidden single)", "A digit that has just one square it can use inside a row, column or box. Experts call it a hidden single."],
  ["last-gap", "Last gap (full house)", "The final empty square in a row, column or box. It takes whichever digit is missing."],
  ["notes", "Notes (pencil marks)", "Small digits written in a square to record which numbers are still possible there."],
];

const FAQS = [
  ["What are the rules of Sudoku?", "Sudoku has one rule: fill the 9×9 grid so that every row, every column and every 3×3 box contains the digits 1 to 9 exactly once. Some digits are printed to start you off. There is no arithmetic; Sudoku is solved by logic alone."],
  ["Is Sudoku maths? Do I need to be good with numbers?", "No. Sudoku uses the digits 1 to 9 only as nine different symbols. Nothing is added, subtracted or multiplied. If you can tell whether a 7 is already in a row, you can solve a Sudoku."],
  ["Where do I start on a Sudoku?", "Start a Sudoku in the 3×3 box, row or column that already has the most numbers, because it has the fewest possibilities. Take one missing digit and ask where in that box it can go. Write it in only when exactly one square is left."],
  ["Do you ever have to guess in Sudoku?", "No. A properly made Sudoku has exactly one solution and every digit can be placed for a reason. If a digit could go in two squares, leave it and look elsewhere. Harder Sudoku puzzles need more advanced reasons than a beginner knows, but they never need a guess."],
  ["Do diagonals count in Sudoku?", "No. In classic Sudoku only the rows, the columns and the nine 3×3 boxes must each contain 1 to 9. The diagonals can repeat digits freely."],
  ["What should I do when I am stuck on a Sudoku?", "When a Sudoku stalls, look for a row, column or box with only one or two gaps, then take the most common digit on the grid and ask where it can go in each box. Change from boxes to rows or columns. A stuck Sudoku nearly always hides one certain number you have not checked yet."],
  ["I made a mistake in my Sudoku. Do I have to start again?", "Usually not. Find the row, column or box that shows the same digit twice, then erase back to the last number you were completely sure of. On paper, check that one box against the answer key rather than the whole grid. This is why Sudoku is played in pencil."],
  ["How long should an easy Sudoku take a beginner?", "A first easy Sudoku commonly takes a beginner fifteen to thirty minutes alone. With a little coaching, a complete first-timer finished Puzzle 1 of Sudoku with a Secret in about nine minutes. Times drop quickly with practice."],
  ["Which Sudoku book is good for a complete beginner?", "Look for a Sudoku book with one large grid per page, a real run of easy puzzles at the start, and answers in the back. Sudoku with a Secret, Volume 1 opens with a Start Here page on page 5 and seventy easy puzzles before anything gets hard."],
];

const LD = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": "https://puzzlesecret.com/how-to-play-sudoku/#article",
      "headline": "How to Play Sudoku for Beginners",
      "description": PAGE_DESC,
      "datePublished": "2026-09-11",
      "dateModified": UPDATED,
      "inLanguage": "en-US",
      "author": { "@id": "https://puzzlesecret.com/#dan" },
      "publisher": { "@id": "https://puzzlesecret.com/#org" },
      "mainEntityOfPage": "https://puzzlesecret.com/how-to-play-sudoku/",
      "image": "https://puzzlesecret.com/art/htp-video-poster.webp",
      "about": { "@type": "Thing", "name": "Sudoku", "sameAs": ["https://www.wikidata.org/wiki/Q101583", "https://en.wikipedia.org/wiki/Sudoku"] },
      "mentions": { "@id": "https://puzzlesecret.com/#book-v1" }
    },
    { "@type": "Person", "@id": "https://puzzlesecret.com/#dan", "name": "Dan Herlehy", "url": "https://puzzlesecret.com/the-keeper/", "description": "Author of Sudoku with a Secret, a 200-puzzle Sudoku book." },
    {
      "@type": "Book", "@id": "https://puzzlesecret.com/#book-v1",
      "name": "Sudoku with a Secret, Volume 1: Crack the Keeper's Vault",
      "author": { "@id": "https://puzzlesecret.com/#dan" },
      "isbn": "9798188603960", "numberOfPages": 252, "bookFormat": "https://schema.org/Paperback",
      "sameAs": "https://www.amazon.com/dp/B0HB9K8PXC",
      "offers": { "@type": "Offer", "price": "14.99", "priceCurrency": "USD", "availability": "https://schema.org/InStock", "url": "https://www.amazon.com/dp/B0HB9K8PXC" }
    },
    {
      "@type": "VideoObject",
      "name": "How to Solve Sudoku for Beginners (Teaching a First-Timer, Uncut)",
      "description": "Fifteen unscripted minutes: the author teaching his uncle his first Sudoku, on Puzzle 1 of Sudoku with a Secret.",
      "thumbnailUrl": ["https://puzzlesecret.com/art/htp-video-poster.webp", `https://i.ytimg.com/vi/${YOUTUBE_ID}/maxresdefault.jpg`],
      "uploadDate": "2026-09-12T23:48:33-07:00",
      "duration": "PT15M32S",
      "embedUrl": `https://www.youtube-nocookie.com/embed/${YOUTUBE_ID}`,
      "contentUrl": `https://www.youtube.com/watch?v=${YOUTUBE_ID}`
    },
    {
      "@type": "HowTo",
      "name": "How to play Sudoku for beginners",
      "description": PAGE_DESC,
      "totalTime": "PT10M",
      "supply": [{ "@type": "HowToSupply", "name": "A pencil with an eraser" }, { "@type": "HowToSupply", "name": "An easy sudoku puzzle" }],
      "step": [
        { "@type": "HowToStep", "name": "Learn the one rule", "text": "Every row, every column and every 3×3 box must contain the digits 1 to 9 exactly once. Nothing else." },
        { "@type": "HowToStep", "name": "Pick the fullest box", "text": "Start with a 3×3 box that already has six or seven numbers in it. Fewer gaps means fewer possibilities." },
        { "@type": "HowToStep", "name": "Find the number with only one place to go", "text": "Take a missing digit. Look along each empty square's row and column; if that digit already appears there, the square is out. When only one square is left, that is where the digit goes." },
        { "@type": "HowToStep", "name": "Do not write it until it is certain", "text": "If a digit could go in two squares, leave it and try another digit. A pencilled guess turns into an error three moves later." },
        { "@type": "HowToStep", "name": "Switch from boxes to rows", "text": "When a box stalls, look at a row or column with only one or two gaps instead. Every number you place removes possibilities somewhere else." },
        { "@type": "HowToStep", "name": "Fill the last gaps and check", "text": "When a box, row or column has one gap left, the missing digit goes there. If it clashes in any direction, erase back to the last number you were sure of." }
      ]
    },
    { "@type": "FAQPage", "mainEntity": FAQS.map(([q, a]) => ({ "@type": "Question", "name": q, "acceptedAnswer": { "@type": "Answer", "text": a } })) },
    { "@type": "BreadcrumbList", "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "PuzzleSecret", "item": "https://puzzlesecret.com/" },
      { "@type": "ListItem", "position": 2, "name": "How to Play Sudoku", "item": "https://puzzlesecret.com/how-to-play-sudoku/" }
    ] }
  ]
};
const CLIENT = { givens: P1.givens, teach: TEACH, mid: MID, moves: MOVES.map((m) => ({ c: m.cell, d: m.digit, k: m.kind, u: m.unit, b: m.blockers, a: m.ask, r: m.reason })) };
const fmt = (s) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
---

<Layout title={PAGE_TITLE} description={PAGE_DESC} ogImage="/art/htp-video-poster.webp">
  <main class="page-htp">
    <script type="application/ld+json" set:html={JSON.stringify(LD)} />

    <div class="htp-hero">
      <p class="eyebrow">For beginners &middot; the one rule &middot; your first number</p>
      <h1>How to Play Sudoku</h1>
      <p class="lede"><strong>Sudoku has one rule: every row, every column and every 3&times;3 box must contain the digits 1 to 9 exactly once.</strong>
      There is no maths and no guessing. You solve a Sudoku by asking, again and again, &ldquo;where is the only place this number can go?&rdquo;</p>
      <a class="btn-try" href="#first-puzzle">Show me the first move &darr;</a>
      <p class="promise">Your first puzzle takes about 10 minutes. Nothing to download, no sign-up.</p>
      <p class="byline">By <a href="/the-keeper">Dan Herlehy</a>, author of <a href="/escape-room-sudoku-book">Sudoku with a Secret</a> &middot; Updated <time datetime={UPDATED}>September 19, 2026</time></p>
    </div>

    <nav class="mini-nav" aria-label="Ways to learn on this page">
      <a href="#first-puzzle">Do it</a><a href="#watch">Watch it</a><a href="#read">Read it</a><a href="/sudoku-cheat-sheet">Print it</a>
    </nav>

    <section class="wrap">
      <h2 class="sec-h" id="the-rule">The rules of Sudoku, in one picture</h2>
      <div class="rule-row">
        <div class="sg sg-rule" role="img" aria-label="A Sudoku grid with one row, one column and one 3 by 3 box highlighted">
          {RULE_CELLS.map((c) => <span class={`c ${c.cls}`} data-i={c.i}>{c.d || ''}</span>)}
        </div>
        <table class="t rule-t">
          <caption class="sr">The three parts of the one Sudoku rule</caption>
          <tbody>
            <tr><th scope="row"><span class="key rowhl"></span> Every row</th><td>holds 1 to 9 once each. The highlighted row still needs a 1, 3 and 8.</td></tr>
            <tr><th scope="row"><span class="key colhl"></span> Every column</th><td>holds 1 to 9 once each, top to bottom.</td></tr>
            <tr><th scope="row"><span class="key boxhl"></span> Every 3&times;3 box</th><td>holds 1 to 9 once each. The thick lines mark the nine boxes.</td></tr>
          </tbody>
        </table>
      </div>
      <p class="body">The printed numbers are called <a href="#g-given">givens</a>. They are correct and never change. Your job is to fill every empty square so that all three parts of the rule hold at once. The most common beginner slip is checking the row and the column and forgetting the box, so always look three ways.</p>

      <h2 class="sec-h" id="first-puzzle">Your first Sudoku, one certain number at a time</h2>
      <p class="sec-sub">This is Puzzle 1 of the book, the same grid as in the video below. The first {TEACH} moves are shown to you with the reason. After that the square is ringed and you choose the number.</p>

      <div class="gs" id="gs" data-state="idle">
        <div class="gs-top"><span id="gsCount">Move 0 of {MOVES.length}</span><span class="gs-bar"><i id="gsBar"></i></span></div>
        <div class="sg sg-main" id="gsGrid" role="img" aria-label="Puzzle 1, a Sudoku grid. The explanation of each move is read out below the grid.">
          {GIVENS.map((d, i) => <span class={`c ${d ? 'gv' : ''}`} data-i={i}>{d || ''}</span>)}
        </div>
        <div class="gs-say" id="gsSay" aria-live="polite"><p>Press the gold button. The page will ring one square, mark the numbers that matter, and tell you why the answer is certain.</p></div>
        <div class="gs-pad" id="gsPad" hidden>
          {[1,2,3,4,5,6,7,8,9].map((n) => <button type="button" data-n={n} aria-label={`Answer ${n}`}>{n}</button>)}
        </div>
        <div class="gs-ctl">
          <button type="button" class="btn-try gs-next" id="gsNext">Show me the first move</button>
          <button type="button" class="gs-sub" id="gsHint" hidden>Give me a hint</button>
          <button type="button" class="gs-sub" id="gsGaps" hidden>Fill the easy last gaps for me</button>
          <button type="button" class="gs-sub" id="gsBack" hidden>&larr; Back one move</button>
          <button type="button" class="gs-sub" id="gsReset" hidden>Start again</button>
        </div>
        <div class="gs-mid" id="gsMid" hidden>
          <p><strong>&ldquo;Oh good. Now I can do it.&rdquo;</strong> That is what a first-timer said at about this point. This is Puzzle 1 of 200. Rather do the rest in pencil? <a href={AMAZON_URL} target="_blank" rel="sponsored noopener">Volume 1 is $14.99 on Amazon ↗</a></p>
        </div>
        <div class="gs-done" id="gsDone" hidden>
          <h3>You just finished Puzzle 1 of the book.</h3>
          <p>Every number went in for a reason, and you never guessed once. That is all Sudoku is. In the book, some squares are shaded, and the numbers that land in them open a vault on this website. <a href="/escape-room-sudoku-book">Here is how that works</a>.</p>
          <p class="done-links"><a class="btn-try" href="/play">Now solve Puzzle 2 yourself &rarr;</a> <a class="btn-amz" href={AMAZON_URL} target="_blank" rel="sponsored noopener">Get the book &middot; $14.99 ↗</a></p>
          <p class="small">Come back tomorrow: <a href="/daily/">a new free puzzle is posted every day</a>, easy ones Monday to Wednesday.</p>
        </div>
      </div>

      <details class="all-moves">
        <summary>Every move of Puzzle 1, with the reason ({MOVES.length} moves, in order)</summary>
        <p>Puzzle 1 can be solved with only two kinds of move: &ldquo;this number has only one place to go&rdquo; ({N_ONLY} moves) and &ldquo;this is the last gap&rdquo; ({N_LAST} moves). Rows are counted from the top, columns from the left.</p>
        <ol>{MOVES.map((m) => <li>{m.reason}</li>)}</ol>
      </details>

      <div class="book-card">
        <a href={AMAZON_URL} target="_blank" rel="sponsored noopener" class="bc-cover"><img src="/art/cover-v1-360.webp" width="360" height="466" loading="lazy" alt="Sudoku with a Secret, Volume 1: Crack the Keeper's Vault — book cover" /></a>
        <div class="bc-body">
          <h3>Is the book all right for a beginner? Yes.</h3>
          <ul>
            <li>A &ldquo;New to Sudoku? Start Here&rdquo; page on page 5 teaches this exact method.</li>
            <li>Seventy easy puzzles come first, before anything gets hard.</li>
            <li>One big grid per 8.5&nbsp;&times;&nbsp;11 page, with room to write.</li>
            <li>All the answers are in the back.</li>
          </ul>
          <a href={AMAZON_URL} target="_blank" rel="sponsored noopener" class="btn-amz">Get Volume 1 &middot; $14.99 on Amazon ↗</a>
        </div>
      </div>

      <h2 class="sec-h" id="watch">Watch a real first-timer learn Sudoku</h2>
      <div class="video">
        <div class="frame">
          <button type="button" class="yt" id="ytBtn" data-id={YOUTUBE_ID} aria-label="Play video: How to solve Sudoku for beginners, teaching a first-timer, uncut (15 minutes)">
            <img src="/art/htp-video-poster.webp" width="960" height="540" loading="lazy" decoding="async" alt="An older man's hand holding a pencil over Puzzle 1 in the Sudoku with a Secret book, at a kitchen table" />
            <span class="yt-play" aria-hidden="true"></span>
          </button>
        </div>
        <p class="video-note">Fifteen unscripted minutes: the author teaching his uncle his first Sudoku on Puzzle 1 of the book. The pauses are the lesson. <a href={`https://www.youtube.com/watch?v=${YOUTUBE_ID}`} target="_blank" rel="noopener">Watch on YouTube ↗</a></p>
        {SHOW_CHAPTERS && <ul class="chapters">{CHAPTERS.map((c) => <li><a href={`https://www.youtube.com/watch?v=${YOUTUBE_ID}&t=${c.t}s`} target="_blank" rel="noopener">{fmt(c.t)}</a> {c.label}</li>)}</ul>}
      </div>

      <h2 class="sec-h" id="read">How to solve a Sudoku: the two questions</h2>
      <p class="body">Every move in beginner Sudoku comes from one of two questions. Question one does most of the work; of the {MOVES.length} moves in Puzzle 1, {N_ONLY} come from it.</p>

      <h3 class="sub-h" id="question-one">Question one: where can this number go?</h3>
      <p class="body">Pick a box and a digit that box is missing. Every copy of that digit elsewhere on the grid &ldquo;looks&rdquo; along its row and its column, and no second copy can sit anywhere in that line. Cross off the squares it rules out. If exactly one empty square survives, the digit goes there. Sudoku players call this scanning, or cross-hatching.</p>
      <div class="frames">
        {FRAMES.map((f) => (
          <figure>
            <div class="sg sg-sm" role="img" aria-label={f.cap}>{f.cells.map((c) => <span class={`c ${c.cls} ${c.placed ? 'pl' : ''}`}>{c.d || ''}</span>)}</div>
            <figcaption>{f.cap}</figcaption>
          </figure>
        ))}
      </div>
      <p class="body note">{M0.reason}</p>

      <h3 class="sub-h" id="question-two">Question two: what can go in this square?</h3>
      <p class="body">Now look at one empty square instead of one digit. Tick off every number already in its row, its column and its box. If only one number is left, write it in. The easiest case is the <a href="#g-last-gap">last gap</a>: a row, column or box with eight numbers has room for only the ninth.</p>
      <div class="frames one">
        <figure>
          <div class="sg sg-sm" role="img" aria-label="A Sudoku grid where one tinted line has a single empty square">{FRAME_LAST.cells.map((c) => <span class={`c ${c.cls}`}>{c.d || ''}</span>)}</div>
          <figcaption>{ML.reason}</figcaption>
        </figure>
      </div>

      <h3 class="sub-h" id="six-moves">Six moves, in order (said out loud at a kitchen table)</h3>
      <p class="body">Everything below was said in September 2026 to someone who had never done a Sudoku. It worked.</p>
      <div class="steps">
        <div class="step"><div class="s-num">01</div><h4>Pick the fullest box</h4><p>&ldquo;I usually try to start with ones that are kind of mostly filled in.&rdquo; A box with two or three gaps has two or three possibilities. A box with six gaps has too many.</p></div>
        <div class="step"><div class="s-num">02</div><h4>Ask where a digit <em>can&rsquo;t</em> go</h4><p>Take one missing digit. Look along each empty square&rsquo;s row and column, and remember the box itself. &ldquo;It can&rsquo;t, because there&rsquo;s an eight here.&rdquo; Cross those squares off.</p></div>
        <div class="step"><div class="s-num">03</div><h4>One square left? Write it</h4><p>&ldquo;So we know a hundred percent &mdash; that&rsquo;s an eight.&rdquo; When exactly one square survives, the digit goes there. That is the only kind of move you ever make.</p></div>
        <div class="step"><div class="s-num">04</div><h4>Two squares left? Leave it</h4><p>&ldquo;If you write the nine in, it still might be able to go there. So you don&rsquo;t want to write it in yet.&rdquo; Try a different digit. Come back later; it will have narrowed.</p></div>
        <div class="step"><div class="s-num">05</div><h4>Stuck? Switch to a row</h4><p>&ldquo;Instead of thinking of it in a square, change your brain to try to finish that row.&rdquo; A row with one gap is a free number, and every number you place removes a possibility somewhere else.</p></div>
        <div class="step"><div class="s-num">06</div><h4>Fill the last gaps, and check</h4><p>&ldquo;That&rsquo;s how you know you got it right &mdash; the last number works.&rdquo; If a last number clashes with its row or column, something earlier was a guess. See <a href="#mistake">how to recover</a>.</p></div>
      </div>

      <h2 class="sec-h" id="stuck">What to do when you are stuck on a Sudoku</h2>
      <p class="body">Being stuck on a Sudoku does not mean the puzzle is broken or that you must guess. It means a certain number is sitting somewhere you have not looked. Try these in order:</p>
      <ol class="checklist">{STUCK.map((s) => <li>{s}</li>)}</ol>

      <h2 class="sec-h" id="mistake">Made a mistake? How to recover on paper</h2>
      <p class="body">A Sudoku mistake rarely shows up where it was made. It shows up later, as the same digit twice in one row, column or box. When that happens: find the pair of duplicates, then erase back to the last number you were completely sure of. With a book, check just that one box against the answer key in the back rather than reading the whole solution. This is the whole reason Sudoku is played in pencil.</p>
      <div class="spot" id="spot">
        <p><strong>Try it: spot the mistake.</strong> This finished box breaks the rule. Tap a number that is wrong.</p>
        <div class="spot-box">{[4,9,2,7,1,6,3,7,5].map((n, i) => <button type="button" data-n={n} aria-label={`Square ${i + 1}: ${n}`}>{n}</button>)}</div>
        <p class="spot-say" id="spotSay" aria-live="polite"></p>
      </div>

      <h2 class="sec-h" id="notes">When should a beginner use notes?</h2>
      <p class="body">Later than most apps suggest. On an easy Sudoku the two questions are enough, and a grid full of tiny numbers hides more than it shows. Start using <a href="#g-notes">notes</a> when the two questions stop producing moves, usually on medium puzzles. On paper, write small digits in the corner of a square only when that square has two possible numbers, and rub them out the moment one is ruled out. A stale note causes more mistakes than no note.</p>

      <h2 class="sec-h" id="myths">Sudoku myths and what is true</h2>
      <table class="t myths">
        <thead><tr><th scope="col">What beginners often think</th><th scope="col">What is true</th></tr></thead>
        <tbody>{MYTHS.map(([m, t]) => <tr><td>{m}</td><td>{t}</td></tr>)}</tbody>
      </table>

      <h2 class="sec-h" id="facts">Key facts from this lesson</h2>
      <table class="t facts">
        <tbody>
          <tr><th scope="row">Grid</th><td>9 rows &times; 9 columns = 81 squares, in nine 3&times;3 boxes</td></tr>
          <tr><th scope="row">The rule</th><td>1 to 9 exactly once in every row, column and box</td></tr>
          <tr><th scope="row">Puzzle 1 of <em>Sudoku with a Secret</em></th><td>39 given numbers; solved in {MOVES.length} moves using only the two beginner moves ({N_ONLY} &ldquo;only place&rdquo;, {N_LAST} &ldquo;last gap&rdquo;)</td></tr>
          <tr><th scope="row">A first-timer&rsquo;s time</th><td>about nine minutes with coaching (filmed, September 2026); 15 to 30 minutes alone is normal</td></tr>
          <tr><th scope="row">Tools</th><td>a pencil and an eraser</td></tr>
        </tbody>
      </table>

      <h2 class="sec-h" id="teach">Teaching Sudoku to a child or a grandparent</h2>
      <p class="body">Sit beside them, not across. Say the rule once, then point at a nearly full box and ask, &ldquo;which numbers are missing?&rdquo; Let them find where one goes; only point when they stall. Never fill a square for them. Use an easy puzzle with big squares, stop after one grid, and let the pauses happen. The video above is fifteen minutes of exactly that.</p>

