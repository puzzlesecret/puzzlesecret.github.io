  <script type="application/json" id="gsData" set:html={JSON.stringify(CLIENT)} />
  <script is:inline>
  (function () {
    // ---- YouTube facade: no third-party request until the visitor asks for the video
    var yb = document.getElementById('ytBtn');
    if (yb) yb.addEventListener('click', function () {
      var f = document.createElement('iframe');
      f.src = 'https://www.youtube-nocookie.com/embed/' + yb.dataset.id + '?autoplay=1';
      f.title = 'How to solve Sudoku for beginners: teaching a first-timer, uncut';
      f.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
      f.allowFullscreen = true;
      yb.replaceWith(f); f.focus();
    });

    // ---- Spot the mistake
    var spot = document.getElementById('spot'), spotSay = document.getElementById('spotSay');
    if (spot) spot.addEventListener('click', function (e) {
      var b = e.target.closest('button'); if (!b) return;
      if (b.dataset.n === '7') {
        spot.querySelectorAll('button[data-n="7"]').forEach(function (x) { x.classList.add('hit'); });
        spotSay.textContent = 'Yes. There are two 7s in this box, and no 8 at all. One of the 7s was a guess; erase back to the last number you were sure of.';
      } else { spotSay.textContent = 'That ' + b.dataset.n + ' appears once, so it is fine. Look for a number that appears twice.'; }
    });

    // ---- Sticky book bar (phones only via CSS), after 30% scroll, dismissible for the session
    var stick = document.getElementById('stick');
    try { if (sessionStorage.getItem('htp_stick_x')) stick = null; } catch (e) {}
    if (stick) {
      window.addEventListener('scroll', function () {
        if (!stick) return;
        var h = document.documentElement;
        stick.hidden = (h.scrollTop / (h.scrollHeight - h.clientHeight)) < 0.3;
      }, { passive: true });
      document.getElementById('stickX').addEventListener('click', function () {
        stick.hidden = true; stick = null; try { sessionStorage.setItem('htp_stick_x', '1'); } catch (e) {}
      });
    }

    // ---- The guided first puzzle
    var D = JSON.parse(document.getElementById('gsData').textContent);
    var M = D.moves, N = M.length, KEY = 'htp_guided_v1';
    var root = document.getElementById('gs'), cells = [].slice.call(document.querySelectorAll('#gsGrid .c'));
    var say = document.getElementById('gsSay'), pad = document.getElementById('gsPad');
    var bNext = document.getElementById('gsNext'), bHint = document.getElementById('gsHint'), bGaps = document.getElementById('gsGaps');
    var bBack = document.getElementById('gsBack'), bReset = document.getElementById('gsReset');
    var n = 0, asking = false, hinted = 0;
    var ev = function (name) { try { window.psEventOnce && window.psEventOnce(name); } catch (e) {} };
    var grid = function () { var g = D.givens.split('').map(Number); for (var i = 0; i < n; i++) g[M[i].c] = M[i].d; return g; };
    var save = function () { try { localStorage.setItem(KEY, String(n)); } catch (e) {} };
    function tell(html) { say.innerHTML = '<p>' + html + '</p>'; }
    function clearMarks() { cells.forEach(function (c) { c.classList.remove('unit', 'block', 'target', 'why'); }); }
    function paint() {
      var g = grid();
      cells.forEach(function (c, i) { if (!c.classList.contains('gv')) { c.textContent = g[i] || ''; c.classList.toggle('pl', !!g[i]); } });
      document.getElementById('gsCount').textContent = 'Move ' + n + ' of ' + N;
      document.getElementById('gsBar').style.width = (100 * n / N) + '%';
      bBack.hidden = bReset.hidden = n === 0;
      document.getElementById('gsMid').hidden = n < D.mid || n >= N;
      document.getElementById('gsDone').hidden = n < N;
      if (n >= D.mid) ev('learn.mid');
    }
    function mark(m, withBlockers) {
      clearMarks();
      m.u.forEach(function (i) { cells[i].classList.add('unit'); });
      if (withBlockers) m.b.forEach(function (i) { cells[i].classList.add('block'); });
      cells[m.c].classList.add('target');
    }
    function place(m, prefix) {
      mark(m, true); n++; asking = false; hinted = 0; save(); paint();
      cells[m.c].classList.add('target');
      tell((prefix || '') + m.r);
      pad.hidden = true; bHint.hidden = true; bGaps.hidden = true;
      if (n >= N) { bNext.hidden = true; clearMarks(); ev('learn.done'); return; }
      bNext.hidden = false;
      bNext.textContent = n < D.teach ? 'Show me the next move' : (n === D.teach ? 'Now let me try one' : 'Next square');
    }
    function ask() {
      var m = M[n]; asking = true; hinted = 0; mark(m, false);
      tell('<strong>Your turn.</strong> Which number goes in the ringed square (row ' + (Math.floor(m.c / 9) + 1) + ', column ' + (m.c % 9 + 1) + ')? Tap it below.');
      pad.hidden = false; bNext.hidden = true; bHint.hidden = false; bHint.textContent = 'Give me a hint';
      bGaps.hidden = m.k !== 'last';
    }
    function step() {
      if (n >= N) return;
      ev('learn.start');
      if (n < D.teach) place(M[n]); else ask();
    }
    bNext.addEventListener('click', step);
    bHint.addEventListener('click', function () {
      var m = M[n]; hinted++;
      if (hinted === 1) { tell('Hint: ' + m.a); bHint.textContent = 'Show me the answer'; if (m.k === 'only') m.b.forEach(function (i) { cells[i].classList.add('block'); }); }
      else place(m);
    });
    bGaps.addEventListener('click', function () {
      var k = 0; while (n < N && M[n].k === 'last') { n++; k++; }
      save(); paint(); clearMarks(); asking = false; pad.hidden = true; bHint.hidden = true; bGaps.hidden = true;
      if (n >= N) { bNext.hidden = true; tell('Filled the last ' + k + ' gaps. Each was the only number missing from its row, column or box.'); ev('learn.done'); return; }
      tell('Filled ' + k + ' last ' + (k === 1 ? 'gap' : 'gaps') + ': each was the only number missing from its row, column or box.');
      bNext.hidden = false; bNext.textContent = 'Next square';
    });
    pad.addEventListener('click', function (e) {
      var b = e.target.closest('button'); if (!b || !asking) return;
      var d = +b.dataset.n, m = M[n];
      if (d === m.d) { place(m, '<strong>Yes, ' + d + '.</strong> '); return; }
      var g = grid(), r = Math.floor(m.c / 9), c = m.c % 9, clash = -1;
      for (var i = 0; i < 81 && clash < 0; i++) {
        if (g[i] !== d) continue;
        var ri = Math.floor(i / 9), ci = i % 9;
        if (ri === r || ci === c || (Math.floor(ri / 3) === Math.floor(r / 3) && Math.floor(ci / 3) === Math.floor(c / 3))) clash = i;
      }
      cells.forEach(function (x) { x.classList.remove('why'); });
      if (clash >= 0) {
        var cr = Math.floor(clash / 9), cc = clash % 9;
        cells[clash].classList.add('why');
        tell('<strong>Not ' + d + '.</strong> There is already ' + (d === 8 ? 'an 8' : 'a ' + d) + ' in the same ' + (cr === r ? 'row' : cc === c ? 'column' : 'box') + ' (marked with a dashed ring). Try another number.');
      } else {
        tell('<strong>Not yet.</strong> The rule would allow ' + (d === 8 ? 'an 8' : 'a ' + d) + ' here, but it could also go somewhere else, so it is not certain. Look for the number that has no other place to go. Tap &ldquo;Give me a hint&rdquo; if you like.');
      }
    });
    bBack.addEventListener('click', function () {
      if (n === 0) return; n--; save(); clearMarks(); paint(); asking = false; pad.hidden = true; bHint.hidden = true; bGaps.hidden = true;
      bNext.hidden = false; bNext.textContent = n === 0 ? 'Show me the first move' : 'Show me the next move';
      tell('Went back one move. You are at move ' + n + ' of ' + N + '.');
    });
    bReset.addEventListener('click', function () {
      n = 0; save(); clearMarks(); paint(); asking = false; pad.hidden = true; bHint.hidden = true; bGaps.hidden = true;
      bNext.hidden = false; bNext.textContent = 'Show me the first move'; tell('Back to the start. Press the gold button for the first move.');
    });
    try { var s = parseInt(localStorage.getItem(KEY) || '0', 10); if (s > 0 && s <= N) { n = s; } } catch (e) {}
    paint();
    if (n > 0 && n < N) { bNext.textContent = n < D.teach ? 'Show me the next move' : 'Next square'; tell('Welcome back. You are at move ' + n + ' of ' + N + '.'); }
    if (n >= N) bNext.hidden = true;
  })();
  </script>

