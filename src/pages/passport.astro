---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Your Passport · PuzzleSecret" description="Your PuzzleSecret Solver's Passport. Every vault you crack in the book stamps it here, and each stamp hands you a bonus puzzle pack.">
  <main class="page-passport">
    <div class="passport-hero">
      <p class="eyebrow">Official Record</p>
      <h1>The Solver's Passport</h1>
      <p class="lede">Every vault you crack stamps this passport. A stamp is earned one way only: solve the puzzles in the book, decode the Keeper's word, and type it into the vault door on our homepage.</p>
    </div>

    <section class="wrap passport-body">
      <!-- Passport Notebook Frame -->
      <div class="passport-book">
        <div class="p-header">
          <div class="p-brand">PUZZLE<span>SECRET</span></div>
          <div class="p-title">Volume 1 · Solver's Passport</div>
        </div>

        <!-- How a stamp is earned: the book → the word → the door -->
        <div class="howto" id="howto">
          <h2 class="howto-kicker">How a stamp is earned</h2>
          <p class="howto-next" id="howtoNext" hidden></p>
          <ol class="howto-steps" id="howtoSteps" role="list">
            <li>
              <span class="step-n" aria-hidden="true">1</span>
              <strong>Solve the book</strong>
              <span>Twenty puzzles in <em>Sudoku with a Secret</em> carry a shaded cell. Solve them and each gives up a digit. The book runs in three acts (easy, medium, hard), and each act hides one word.</span>
            </li>
            <li>
              <span class="step-n" aria-hidden="true">2</span>
              <strong>Decode the word</strong>
              <span>Write the digits on the book's Vault Door tally page, then decode them with the Keyplate at the back of the book. Out comes that act's word.</span>
            </li>
            <li>
              <span class="step-n" aria-hidden="true">3</span>
              <strong>Type it at the door</strong>
              <span>Come to this site's homepage and type the word into the vault door there. It opens, the stamp lands here, and the bonus-puzzle PDF is yours to download.</span>
            </li>
          </ol>
          <div class="howto-cta">
            <a href="/" class="btn-gold" id="howtoBtn">I have the book · type my word <span aria-hidden="true">→</span></a>
            <a href="https://www.amazon.com/dp/B0HB9K8PXC" class="btn-ghost" target="_blank" rel="noopener">No book yet? Get Volume 1 on Amazon <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
          </div>
          <p class="howto-foot">Every stamp starts with the book. Nothing here can be bought, only cracked.</p>
        </div>

        <h2 class="stamps-kicker" id="stampsKicker">Your stamps · <span id="stampsInline">0 of 4</span></h2>
        <div class="stamps-grid">
          <!-- Stamp 1 -->
          <div class="stamp-slot" id="slot-v1">
            <div class="stamp-inner">
              <div class="stamp-num">I</div>
              <div class="stamp-icon" aria-hidden="true">🖋</div>
              <div class="stamp-name">The Writer's Study</div>
              <div class="stamp-act">Act I of the book · Easy</div>
              <div class="stamp-status"><span aria-hidden="true">🔒</span> Locked</div>
              <span class="stamp-date"></span>
            </div>
            <a href="#" download class="stamp-dl" data-act="I" hidden>Download 50 easy puzzles (PDF) <span aria-hidden="true">⬇</span></a>
            <span class="stamp-locked" data-act="I">Solve Act I in the book, then type its word at the door to unlock <b>50 bonus easy puzzles</b>.</span>
          </div>

          <!-- Stamp 2 -->
          <div class="stamp-slot" id="slot-v2">
            <div class="stamp-inner">
              <div class="stamp-num">II</div>
              <div class="stamp-icon" aria-hidden="true">📜</div>
              <div class="stamp-name">Library of Puzzles</div>
              <div class="stamp-act">Act II of the book · Medium</div>
              <div class="stamp-status"><span aria-hidden="true">🔒</span> Locked</div>
              <span class="stamp-date"></span>
            </div>
            <a href="#" download class="stamp-dl" data-act="II" hidden>Download 100 medium puzzles (PDF) <span aria-hidden="true">⬇</span></a>
            <span class="stamp-locked" data-act="II">Solve Act II in the book, then type its word at the door to unlock <b>100 bonus medium puzzles</b>.</span>
          </div>

          <!-- Stamp 3 -->
          <div class="stamp-slot" id="slot-v3">
            <div class="stamp-inner">
              <div class="stamp-num">III</div>
              <div class="stamp-icon" aria-hidden="true">🏆</div>
              <div class="stamp-name">Grand Treasure Vault</div>
              <div class="stamp-act">Act III of the book · Hard</div>
              <div class="stamp-status"><span aria-hidden="true">🔒</span> Locked</div>
              <span class="stamp-date"></span>
            </div>
            <a href="#" download class="stamp-dl" data-act="III" hidden>Download 200 hard puzzles (PDF) <span aria-hidden="true">⬇</span></a>
            <span class="stamp-locked" data-act="III">Solve Act III in the book, then type its word at the door to unlock <b>200 bonus hard puzzles</b>.</span>
          </div>

          <!-- Stamp 4 (Secret) -->
          <div class="stamp-slot secret-slot" id="slot-v4">
            <div class="stamp-inner">
              <div class="stamp-num">IV</div>
              <div class="stamp-icon" aria-hidden="true">🕯</div>
              <div class="stamp-name">The Secret Sanctum</div>
              <div class="stamp-act">A door the book never mentions</div>
              <div class="stamp-status"><span aria-hidden="true">🔒</span> Hidden</div>
              <span class="stamp-date"></span>
            </div>
            <a href="#" download class="stamp-dl" data-act="IV" hidden>Download 20 master puzzles (PDF) <span aria-hidden="true">⬇</span></a>
            <span class="stamp-locked" data-act="IV">Something was never announced. Find it, and a fourth stamp appears.</span>
          </div>
        </div>

        <p class="p-warn">
          <strong>Your passport is saved on this device only.</strong> We never receive it, so we can't
          restore it. Clear your browsing data, switch browsers, or open the site on another phone or
          computer, and the stamps and downloads won't be there. No harm done: type your words at the
          door again and everything comes straight back. The words are in your book. That is your backup.
        </p>

        <!-- The Keeper's key-tiles (the two games in the painted vault) + the standing -->
        <div class="p-row">
          <div class="tiles-row" role="group" aria-label="Key-tiles recovered">
            <div class="ktile" id="tile-II" data-digit="5"><span>?</span><small>Library</small></div>
            <div class="ktile" id="tile-III" data-digit="7"><span>?</span><small>Treasure</small></div>
            <p class="tiles-note" id="tilesNote">Two key-tiles are hidden inside the vault: one in the library's dark, one in a locked chest. Beat the Keeper's two little games to collect them. Hold both and the Keeper's Mark seals your certificate.</p>
          </div>
          <div class="rank-box">
            <p class="rank-lbl">Your standing</p>
            <p class="rank" id="rankName">Visitor</p>
            <p class="rank-sub" id="rankSub">Crack the first vault to earn a title.</p>
            <a href="/" class="rank-next" id="rankNext" hidden>Type the next word <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <!-- The certificate: a keepsake, drawn in this browser only -->
        <div class="cert-box" id="certBox" hidden>
          <div>
            <h3>Your certificate</h3>
            <p>“Cracked the Keeper's Vault”: your initials, the date, the vaults you opened. Made here, saved to your device, never sent anywhere.</p>
          </div>
          <button type="button" class="btn-cert" id="certBtn">Make my certificate</button>
        </div>

        <!-- The next stamp: a book not yet written -->
        <div class="next-slot" role="group" aria-label="Volume II, coming">
          <div class="stamp-num next-num" style="color:var(--v2)">Vol. II</div>
          <div>
            <div class="stamp-name">Volume II · The Corsair's Chart</div>
            <div class="next-status">Coming soon. Its own stamps will appear here.</div>
          </div>
        </div>

        <!-- Passport Stats Bar: shown once there is something to count -->
        <div class="p-stats" id="stats" hidden>
          <div class="stat">
            <span class="stat-num" id="unlockedPuzzles">0</span>
            <span class="stat-lbl">Bonus puzzles unlocked</span>
          </div>
          <div class="stat" id="pagesStat" hidden>
            <span class="stat-num" id="storyPages">0 / 9</span>
            <span class="stat-lbl">Pages of the Keeper's story found while exploring the vault</span>
          </div>
        </div>
      </div>

      <div class="passport-cta">
        <a href="/" class="btn-vault" id="ctaBtn">Type your first word <span aria-hidden="true">→</span></a>
        <a href="/vault" class="cta-alt" id="ctaAlt">Or look inside the vaults first (no word needed)</a>
      </div>
    </section>
  </main>

  <style is:global>
    /* the certificate panel (shared with /vault; markup is built by /js/keeper-certificate.js) */
    #certPanel { position: fixed; inset: 0; z-index: 60; display: flex; align-items: center; justify-content: center; background: rgba(4,2,0,.72); backdrop-filter: blur(3px); padding: 16px; overflow-y: auto; }
    #certPanel[hidden] { display: none; }
    .cert-card { max-width: 480px; width: 100%; margin: auto; text-align: center; background: linear-gradient(180deg, #1d1207, #120a04); border: 1px solid rgba(246,178,60,.45); border-radius: 8px; padding: 28px 24px 20px; box-shadow: 0 0 60px rgba(246,178,60,.18), 0 18px 50px rgba(0,0,0,.7); font-family: var(--serif); color: var(--ivory); }
    .cert-kicker { font-family: var(--display); font-size: 12px; letter-spacing: .3em; color: #c78d2e; margin-bottom: 12px; }
    .cert-line { font-size: 16px; font-style: italic; color: var(--ash); margin-bottom: 16px; line-height: 1.45; }
    .cert-row { display: flex; gap: 8px; margin-bottom: 14px; }
    .cert-row input { flex: 1; min-width: 0; font-family: var(--display); font-size: 22px; letter-spacing: .4em; text-align: center; text-transform: uppercase; color: var(--gold); background: rgba(0,0,0,.45); border: 1px solid rgba(246,178,60,.4); border-radius: 4px; padding: 10px 4px 10px 12px; min-height: 48px; }
    .cert-row input::placeholder { color: rgba(232,213,174,.55); letter-spacing: .04em; text-transform: none; font-style: italic; font-size: 15px; }
    .cert-row input.bad { border-color: #e08a6a; }
    .cert-row .gold-btn { margin: 0; white-space: nowrap; padding: 0 18px; display: flex; align-items: center; }
    .cert-out img { width: 100%; height: auto; border: 1px solid rgba(246,178,60,.35); border-radius: 4px; box-shadow: 0 10px 30px rgba(0,0,0,.7); }
    .cert-hint { font-size: 14px; font-style: italic; color: #b3a98f; margin: 8px 0 12px; }
    .cert-actions { display: flex; flex-direction: column; gap: 8px; margin-bottom: 8px; }
    .cert-actions .gold-btn, .cert-actions .ghost-btn { margin: 0; }
    .cert-actions[hidden], .cert-out[hidden], #certPanel .ghost-btn[hidden], #certPanel .gold-btn[hidden] { display: none; }
    #certPanel .gold-btn { display: block; font-family: var(--display); font-size: 13px; letter-spacing: .16em; color: #0b0704; background: linear-gradient(180deg, var(--gold-hi), var(--gold)); border-radius: 4px; padding: 14px 10px; text-decoration: none; border: none; cursor: pointer; box-shadow: 0 0 24px rgba(246,178,60,.3); }
    #certPanel .ghost-btn { display: block; width: 100%; font-family: var(--display); font-size: 13px; letter-spacing: .16em; color: var(--ash); background: none; border: 1px solid rgba(232,213,174,.25); border-radius: 4px; padding: 11px 10px; cursor: pointer; min-height: 44px; margin-top: 4px; }

    /* ---- the passport itself. Brighter and larger than the rest of the site: this is a page people READ. ---- */
    .page-passport { --pp-text: #d9cfb8; --pp-soft: #b3a98f; padding-top: 90px; padding-bottom: 80px; }
    .page-passport .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .page-passport a:focus-visible, .page-passport button:focus-visible { outline: 3px solid var(--gold-hi); outline-offset: 3px; border-radius: 6px; }
    .btn-gold:focus-visible, .btn-vault:focus-visible, .btn-cert:focus-visible { outline-color: var(--ivory); }
    .passport-hero { text-align: center; max-width: 700px; margin: 0 auto 36px; padding: 0 20px; }
    .eyebrow { font-family: var(--display); font-size: 13px; letter-spacing: .3em; text-transform: uppercase; color: var(--gold); margin-bottom: 12px; }
    .passport-hero h1 { font-family: var(--display); font-size: clamp(34px, 5.5vw, 54px); font-weight: 600; color: var(--ivory); line-height: 1.1; margin-bottom: 14px; }
    .lede { font-size: clamp(17px, 2.1vw, 20px); color: var(--pp-text); line-height: 1.5; }

    .wrap { max-width: 900px; margin: 0 auto; padding: 0 20px; }

    .passport-book { background: linear-gradient(180deg, #1b1712, #0f0c09); border: 2px solid var(--brass); border-radius: 16px; padding: 36px; box-shadow: 0 12px 50px rgba(0,0,0,.7), inset 0 0 20px rgba(246,178,60,.1); position: relative; }
    .p-header { text-align: center; margin-bottom: 26px; border-bottom: 1px solid rgba(185,143,82,.3); padding-bottom: 18px; }
    .p-brand { font-family: var(--display); font-size: 17px; font-weight: 700; letter-spacing: .3em; color: var(--pp-text); }
    .p-brand span { color: var(--gold); }
    .p-title { font-style: italic; font-size: 16px; color: var(--pp-soft); margin-top: 4px; }

    /* how a stamp is earned */
    .howto { background: rgba(246,178,60,.05); border: 1px solid rgba(246,178,60,.3); border-radius: 12px; padding: 22px 22px 18px; margin-bottom: 30px; }
    .howto[hidden] { display: none; }
    .howto-kicker { font-family: var(--display); font-size: 13px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--gold-hi); text-align: center; margin: 0 0 16px; }
    .howto-next { font-size: 17px; color: var(--pp-text); text-align: center; line-height: 1.45; margin: -4px 0 14px; }
    .howto-next[hidden] { display: none; }
    .howto-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .howto-steps[hidden] { display: none; }
    .howto-steps li { display: grid; grid-template-columns: 34px 1fr; grid-template-rows: auto auto; column-gap: 12px; row-gap: 4px; align-items: start; }
    .step-n { grid-row: 1 / span 2; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; border-radius: 50%; border: 1px solid var(--gold); color: var(--gold-hi); font-family: var(--display); font-size: 15px; font-weight: 700; }
    .howto-steps strong { font-family: var(--display); font-size: 16px; letter-spacing: .04em; color: var(--ivory); font-weight: 700; }
    .howto-steps li > span:last-child { font-size: 15.5px; line-height: 1.45; color: var(--pp-text); }
    .howto-steps em { font-style: italic; color: var(--gold-hi); }
    .howto-cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 18px; }
    .btn-gold { display: inline-flex; align-items: center; justify-content: center; text-align: center; min-height: 46px; max-width: 100%; padding: 12px 22px; font-family: var(--display); font-weight: 700; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: #1a1206; background: linear-gradient(180deg, var(--gold-hi), var(--gold)); border-radius: 6px; box-shadow: 0 6px 20px rgba(246,178,60,.3); text-decoration: none; }
    .btn-ghost { display: inline-flex; align-items: center; justify-content: center; text-align: center; min-height: 46px; max-width: 100%; padding: 12px 20px; font-family: var(--display); font-size: 13px; letter-spacing: .08em; color: var(--gold-hi); border: 1px solid var(--gold); border-radius: 6px; text-decoration: none; background: rgba(0,0,0,.25); }
    .btn-ghost:hover { background: rgba(246,178,60,.14); }
    .howto-foot { margin-top: 14px; text-align: center; font-size: 15px; font-style: italic; color: var(--pp-soft); }

    .stamps-kicker { font-family: var(--display); font-size: 13px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--pp-soft); margin: 0 0 12px; }
    .stamps-kicker span { color: var(--gold-hi); }
    .stamps-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(172px, 1fr)); gap: 16px; margin-bottom: 18px; }
    .stamp-slot { background: rgba(10,8,6,.7); border: 1px dashed rgba(185,143,82,.5); border-radius: 12px; padding: 20px 14px 16px; text-align: center; display: flex; flex-direction: column; justify-content: space-between; gap: 12px; }
    .stamp-slot.unlocked { border-style: solid; border-color: var(--gold); background: rgba(246,178,60,.09); box-shadow: 0 0 28px rgba(246,178,60,.12); }
    .stamp-num { font-family: var(--display); font-size: 22px; font-weight: 700; color: var(--gold); opacity: .8; }
    .stamp-icon { font-size: 34px; margin: 4px 0; }
    .stamp-name { font-family: var(--display); font-size: 15px; letter-spacing: .06em; color: var(--ivory); line-height: 1.25; }
    .stamp-act { font-size: 14.5px; font-style: italic; color: var(--pp-soft); margin-top: 4px; }
    .stamp-status { font-family: var(--display); font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--pp-soft); margin-top: 8px; }
    .stamp-dl { display: flex; align-items: center; justify-content: center; min-height: 44px; font-family: var(--display); font-size: 13px; letter-spacing: .06em; text-transform: uppercase; padding: 12px 10px; border: 1px solid rgba(246,178,60,.55); border-radius: 6px; color: var(--gold-hi); background: rgba(246,178,60,.08); transition: background .2s; line-height: 1.35; }
    .stamp-dl:hover { background: rgba(246,178,60,.22); }
    .stamp-dl[hidden] { display: none; }
    .stamp-locked { display: block; font-size: 14.5px; line-height: 1.45; color: var(--pp-text); padding: 8px 2px 0; border-top: 1px solid rgba(185,143,82,.2); }
    .stamp-locked b { color: var(--gold-hi); font-weight: 600; }
    .stamp-locked[hidden] { display: none; }

    .p-warn { margin: 0 0 22px; padding: 14px 16px; border: 1px dashed rgba(246,178,60,.45); border-radius: 8px; color: var(--pp-text); font-size: 15px; line-height: 1.55; }
    .p-warn strong { color: var(--gold-hi); }

    .p-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; background: rgba(0,0,0,.4); border-radius: 10px; padding: 22px 20px; text-align: center; border: 1px solid rgba(255,255,255,.07); }
    .p-stats[hidden], .stat[hidden] { display: none; }
    .p-stats.one { grid-template-columns: 1fr; }
    .stat-num { display: block; font-family: var(--display); font-size: 28px; font-weight: 700; color: var(--gold-hi); margin-bottom: 6px; }
    .stat-lbl { font-size: 15px; color: var(--pp-text); line-height: 1.35; }

    .passport-cta { text-align: center; margin-top: 32px; display: flex; flex-direction: column; align-items: center; gap: 8px; }
    .btn-vault { display: inline-flex; align-items: center; justify-content: center; text-align: center; max-width: 100%; min-height: 48px; padding: 14px 32px; font-family: var(--display); font-weight: 700; font-size: 14px; letter-spacing: .14em; text-transform: uppercase; color: #1a1206; background: linear-gradient(180deg, var(--gold-hi), var(--gold)); border-radius: 6px; box-shadow: 0 6px 20px rgba(246,178,60,.3); }
    .cta-alt { display: inline-block; padding: 12px 8px; font-size: 15.5px; color: var(--pp-soft); text-decoration: underline; text-underline-offset: 3px; }
    .cta-alt:hover { color: var(--gold-hi); }

    .p-row { display: grid; grid-template-columns: 1fr 230px; gap: 18px; margin-bottom: 20px; }
    .tiles-row { display: grid; grid-template-columns: auto auto 1fr; gap: 14px; align-items: center; background: rgba(0,0,0,.35); border: 1px solid rgba(255,255,255,.07); border-radius: 10px; padding: 16px; }
    .ktile { width: 60px; height: 60px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(180deg, #2a2620, #1a1712); color: rgba(232,213,174,.55); border: 2px dashed rgba(185,143,82,.45); border-radius: 4px; font-family: var(--display); }
    .ktile span { font-size: 24px; font-weight: 700; line-height: 1; }
    .ktile small { font-size: 10px; letter-spacing: .06em; text-transform: uppercase; margin-top: 4px; }
    .ktile.have { background: linear-gradient(180deg, #d9cdb1, #bfb296); color: #1a1206; border: 2px solid #1a1206; outline: 2px solid var(--gold); outline-offset: 1px; box-shadow: 0 0 22px rgba(246,178,60,.4); }
    .tiles-note { font-size: 15px; color: var(--pp-text); line-height: 1.45; }
    .rank-box { background: rgba(246,178,60,.07); border: 1px solid rgba(246,178,60,.35); border-radius: 10px; padding: 16px; text-align: center; display: flex; flex-direction: column; justify-content: center; }
    .rank-lbl { font-family: var(--display); font-size: 12px; letter-spacing: .22em; text-transform: uppercase; color: var(--pp-soft); }
    .rank { font-family: var(--display); font-size: 22px; font-weight: 700; color: var(--gold-hi); margin: 6px 0 4px; }
    .rank-sub { font-size: 14.5px; font-style: italic; color: var(--pp-text); line-height: 1.4; }
    .rank-next { display: inline-block; margin-top: 8px; padding: 10px 6px; font-family: var(--display); font-size: 13px; letter-spacing: .1em; text-transform: uppercase; color: var(--gold-hi); text-decoration: underline; text-underline-offset: 4px; }
    .rank-next[hidden] { display: none; }
    .cert-box { display: flex; align-items: center; justify-content: space-between; gap: 18px; background: linear-gradient(180deg, rgba(40,32,18,.6), rgba(16,12,6,.6)); border: 1px solid rgba(246,178,60,.35); border-radius: 10px; padding: 18px 20px; margin-bottom: 20px; }
    .cert-box[hidden] { display: none; }
    .cert-box h3 { font-family: var(--display); font-size: 17px; color: var(--gold-hi); margin-bottom: 4px; }
    .cert-box p { font-size: 15px; font-style: italic; color: var(--pp-text); line-height: 1.45; }
    .btn-cert { flex: none; min-height: 44px; padding: 13px 20px; font-family: var(--display); font-weight: 700; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: #1a1206; background: linear-gradient(180deg, var(--gold-hi), var(--gold)); border: none; border-radius: 6px; cursor: pointer; box-shadow: 0 6px 20px rgba(246,178,60,.3); }
    .next-slot { display: flex; align-items: center; gap: 16px; border: 1px dashed rgba(53,207,127,.4); border-radius: 10px; padding: 14px 18px; margin-bottom: 20px; }
    .next-slot .stamp-name { color: var(--ivory); }
    .next-num { font-size: 15px; letter-spacing: .06em; white-space: nowrap; }
    .next-status { font-size: 15px; font-style: italic; color: var(--pp-soft); margin-top: 3px; line-height: 1.4; }

    /* a sealed slot reads as an empty space waiting for ink */
    .stamp-slot:not(.unlocked) .stamp-icon { filter: grayscale(1); opacity: .35; }
    .stamp-slot:not(.unlocked) .stamp-name { color: var(--pp-text); }
    .stamp-slot.unlocked .stamp-num { opacity: 1; }
    .stamp-slot.unlocked .stamp-status { color: var(--gold-hi); }
    .stamp-date { display: block; font-family: var(--display); font-size: 12px; letter-spacing: .1em; color: var(--brass-hi); margin-top: 5px; min-height: 1px; }

    /* the press: a stamp landing on the page for the first time */
    @keyframes stampPress {
      0%   { transform: scale(2.4) rotate(-14deg); opacity: 0; }
      55%  { transform: scale(.92) rotate(3deg);   opacity: 1; }
      75%  { transform: scale(1.04) rotate(-1deg); }
      100% { transform: scale(1) rotate(0deg);     opacity: 1; }
    }
    .stamp-slot.just-earned .stamp-inner { animation: stampPress .62s cubic-bezier(.2,.9,.3,1.2) both; }
    @media (prefers-reduced-motion: reduce) {
      .stamp-slot.just-earned .stamp-inner { animation: none; }
    }

    @media (max-width: 720px) {
      .howto-steps { grid-template-columns: 1fr; gap: 14px; }
      .p-row { grid-template-columns: 1fr; }
      .cert-box { flex-direction: column; align-items: stretch; text-align: center; }
    }
    @media (max-width: 600px) {
      .passport-book { padding: 22px 16px; }
      .howto { padding: 18px 16px 16px; }
      .howto-cta { flex-direction: column; align-items: stretch; }
      .p-stats { grid-template-columns: 1fr; gap: 14px; }
      .tiles-row { grid-template-columns: auto auto; }
      .tiles-note { grid-column: 1 / -1; }
      .stamps-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 400px) {
      .btn-gold, .btn-vault, .btn-ghost { letter-spacing: .06em; padding-left: 14px; padding-right: 14px; }
    }
  </style>

  <script is:inline>
    (function () {
      // The passport reads the hunt this browser remembers. Nothing is sent anywhere.
      var read = function (k, d) {
        try { var v = JSON.parse(localStorage.getItem(k)); return v == null ? d : v; }
        catch (e) { return d; }
      };
      var vaults = read('ps_vaults_v1', {}) || {};
      var story  = read('ps_story_v1', []) || [];
      var seen   = read('ps_stamps_seen_v1', []) || [];

      var PUZZLES = { I: 50, II: 100, III: 200, IV: 20 };
      var ACTS = ['I', 'II', 'III', 'IV'];
      var earned = 0, puzzles = 0, fresh = [];
      // the gifts' addresses, handed out only for a true word — a download shows only when held
      var held = read('ps_rewards_v1', {}) || {};
      ACTS.forEach(function (act) {
        var a = document.querySelector('.stamp-dl[data-act="' + act + '"]'), l = document.querySelector('.stamp-locked[data-act="' + act + '"]');
        if (held[act]) { a.href = held[act]; a.hidden = false; if (l) l.hidden = true; }
      });

      ACTS.forEach(function (act, i) {
        var slot = document.getElementById('slot-v' + (i + 1));
        if (!slot) return;
        var when = vaults[act];
        if (!when) return;
        earned++; puzzles += PUZZLES[act];
        slot.classList.add('unlocked');
        var st = slot.querySelector('.stamp-status'); st.textContent = '';
        var tick = document.createElement('span'); tick.setAttribute('aria-hidden', 'true'); tick.textContent = '✔ ';
        st.appendChild(tick); st.appendChild(document.createTextNode('Cracked'));
        slot.querySelector('.stamp-date').textContent = 'Stamped ' + String(when);
        if (seen.indexOf(act) === -1) { fresh.push(act); slot.classList.add('just-earned'); }
      });

      var pages = story.filter(function (n) { return typeof n === 'number'; }).length;
      document.getElementById('unlockedPuzzles').textContent = String(puzzles);
      document.getElementById('stampsInline').textContent = earned + ' of 4';
      document.getElementById('storyPages').textContent = pages + ' / 9';
      // the counters only appear once there is something to count
      var stats = document.getElementById('stats'), pagesStat = document.getElementById('pagesStat');
      if (puzzles > 0 || pages > 0) { stats.hidden = false; if (pages > 0) pagesStat.hidden = false; else stats.classList.add('one'); }

      // key-tiles (from the painted vault's two games) and the standing
      var tiles = read('ps_tiles_v1', {}) || {};
      ['II', 'III'].forEach(function (k) {
        var t = document.getElementById('tile-' + k);
        if (tiles[k]) { t.classList.add('have'); t.querySelector('span').textContent = t.getAttribute('data-digit'); }
      });
      var both = tiles.II && tiles.III;
      document.getElementById('tilesNote').textContent = both
        ? 'Both key-tiles recovered. The Keeper’s Mark now seals your certificate.'
        : (tiles.II || tiles.III) ? 'One key-tile recovered. The other is still hidden inside the vault: beat the Keeper’s other little game to collect it, and the Keeper’s Mark will seal your certificate.'
        : 'Two key-tiles are hidden inside the vault: one in the library’s dark, one in a locked chest. Beat the Keeper’s two little games to collect them. Hold both and the Keeper’s Mark seals your certificate.';
      // only the EARNED title is ever shown; unearned names stay unwritten
      var RANK = [
        ['Visitor', 'Crack the first vault to earn a title.', '', '/'],
        ['Apprentice', 'One door opened. The Keeper has noticed.', 'Type the second word →', '/'],
        ['Solver', 'Two doors. You read the letter, and it read you.', 'Type the third word →', '/'],
        ['Vault Cracker', 'Three words, three doors. The vault is yours.', 'Back to the vaults →', '/vault'],
        ['The Keeper’s Equal', 'You found what was never lit.', 'Back to the vaults →', '/vault'],
      ][Math.min(earned, 4)];
      document.getElementById('rankName').textContent = RANK[0];
      document.getElementById('rankSub').textContent = RANK[1];
      var nx = document.getElementById('rankNext');
      if (RANK[2]) { nx.textContent = RANK[2]; nx.href = RANK[3]; nx.hidden = false; }

      // the how-to shrinks once the passport has ink in it, and goes once the three acts are done
      var NEXT_ACT = { 1: 'Act II', 2: 'Act III' };
      var cta = document.getElementById('ctaBtn'), alt = document.getElementById('ctaAlt');
      if (earned === 0) {
        cta.textContent = 'Type your first word →'; cta.href = '/';
        alt.textContent = 'Or look inside the vaults first (no word needed)'; alt.href = '/vault';
      } else if (earned < 3) {
        cta.textContent = 'Type the next word →'; cta.href = '/';
        alt.textContent = 'Return to the vaults'; alt.href = '/vault';
        document.getElementById('howtoSteps').hidden = true;
        var hn = document.getElementById('howtoNext');
        hn.textContent = 'Next: decode ' + NEXT_ACT[earned] + '’s word in the book, then type it into the vault door on the homepage.';
        hn.hidden = false;
        document.getElementById('howtoBtn').textContent = 'Type the next word →';
        // a stamp proves the book is in hand: no need to sell it again
        document.querySelector('.btn-ghost').hidden = true;
        document.querySelector('.howto-foot').hidden = true;
      } else {
        cta.textContent = 'Return to the vaults →'; cta.href = '/vault';
        alt.textContent = 'Type a word again'; alt.href = '/';
        document.getElementById('howto').hidden = true;
      }

      if (earned > 0) {
        var box = document.getElementById('certBox'); box.hidden = false;
        document.getElementById('certBtn').addEventListener('click', function () {
          var go = function () { window.PSCert.open(window.PSCert.fromStorage()); };
          if (window.PSCert) go();
          else { var s = document.createElement('script'); s.src = '/js/keeper-certificate.js'; s.onload = go; document.head.appendChild(s); }
        });
      }

      // remember which stamps we've already celebrated, so the press only plays once
      if (fresh.length) {
        try { localStorage.setItem('ps_stamps_seen_v1', JSON.stringify(seen.concat(fresh))); }
        catch (e) { /* private mode — it'll just animate again next visit */ }
      }
    })();
  </script>
</Layout>
