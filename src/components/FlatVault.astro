<script is:inline>
  // ---- mode decision, made SYNCHRONOUSLY (see the note at the top of this file) --------
  (function () {
    // Dan's call (2026-09-03): the 3D crawl is the default, every time. The painted vault is
    // reached only through the small link under the gate button (?mode=painted) or the drawer.
    var qp = new URLSearchParams(location.search);
    var want3d = !(qp.get('mode') === 'painted' || qp.get('flat') === '1');
    if (want3d) {
      var webgl = false;
      try { var c = document.createElement('canvas'); webgl = !!(window.WebGLRenderingContext && (c.getContext('webgl2') || c.getContext('webgl'))); } catch (e) { webgl = false; }
      window.__hasWebGL = webgl;
      if (!webgl) want3d = false;
    }
    window.__flatMode = !want3d;              // read by vault.astro's loader before any module runs
    window.__flatReason = want3d ? null : 'painted';
    if (!want3d) {
      // hide the 3D gate/fade right now so the painted gate is what paints first
      var s = document.createElement('style'); s.textContent = '#gate,#fade,#hud{display:none!important}'; document.head.appendChild(s);
    }
  })();
</script>
